// a compiler-shaped workload: scan a string byte by byte, build a new
// string with байтТавих, count lines - what a mon_lang lexer will do.
// String literals are immutable (they live in read-only text); building
// strings needs a мөрШинэ buffer.
// шалгах: гаралт "3 27 АБВ\n"
функц үндсэн() -> тоо {
    файлБичих("/tmp/mon_lex_test.txt", "нэг\nхоёр\nгурав\n");
    зарла с: мөр = файлУншихБүтэн("/tmp/mon_lex_test.txt");
    зарла мөрТоо: тоо = 0;
    зарла и: тоо64 = 0;
    зарла у: тоо64 = мөрУрт(с);
    давтах и < у бол {
        хэрэв байт(с, и) == 10 бол {
            мөрТоо = мөрТоо + 1;
        }
        и = и + 1;
    }
    хэвлэ(мөрТоо);
    мөр_хэвлэх(" ");
    хэвлэ(у);
    мөр_хэвлэх(" ");

    зарла буф: мөр = мөрШинэ(6);
    байтТавих(буф, 0, 208);
    байтТавих(буф, 1, 144);
    байтТавих(буф, 2, 208);
    байтТавих(буф, 3, 145);
    байтТавих(буф, 4, 208);
    байтТавих(буф, 5, 146);
    мөр_хэвлэх(буф);
    мөр_хэвлэх("\n");
    буц 0;
}
