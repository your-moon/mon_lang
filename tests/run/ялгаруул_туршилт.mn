// mc: бүрэн урд тал → x86_64 ассемблер (source→lex→parse→IR→alloc→emit)
// шалгах: гаралт "\tmovq $2, %rbx\n\tmovq $3, %r12\n\tmovq %rbx, %rax\n\taddq %r12, %rax\n\tmovq %rax, %r13\n\tmovq %r13, %rax\n\tret\n"
ашигла "../../mc/ир";
ашигла "../../mc/парсер";
ашигла "../../mc/кодген";

функц үндсэн() -> тоо {
    зарла п: Парсер;
    п.эхлүүл("функц т() -> тоо { буц 2 + 3; }");
    зарла пр: Зангилаа;
    пр = п.програм();
    зарла бу: Зангилаа;
    бу = пр.жагс[0].б.жагс[0];

    зарла лф: Функц;
    лф.эхлүүл();
    зарла үр: тоо = лф.илэрхийлэл(бу.а);
    лф.буцаа(үр);

    зарла инт: Интервал[];
    инт = лф.амьдрал();
    зарла хув: Хуваарь[];
    хув = лф.хуваарилах(инт, 5);

    зарла я: Ялгаруулагч;
    я.эхлүүл();
    я.ялгаруул(лф, хув);
    мөр_хэвлэх(я.гарц);
    буц 0;
}
