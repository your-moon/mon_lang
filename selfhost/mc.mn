// mc — the mon_lang compiler, written in mon_lang.
//
// Compiles a self-hostable subset (functions, тоо64, locals/globals,
// arithmetic, comparisons, if/while/break, calls, string literals, print,
// file I/O, byte ops) to x86_64 AT&T assembly. Single pass, no AST: a stack
// machine whose stack is a frame region, so rsp never moves and every call
// is 16-byte aligned. Symbol tables are parallel arrays — mc uses no structs,
// so it can compile itself.
//
// The compiler is split into modules resolved with `ашигла`:
//   лексер.mn — tokeniser
//   кодген.mn — symbol tables + x86_64 emitter
// This driver inlines the source of every local ".mn" import before lexing,
// exactly as the Go-hosted front end merges them, so mc still self-hosts.
//
// Usage: mc <source.mn>   (writes out.s; assemble with cc out.s stdlib/cc/lib.c)

ашигла "тэмдэгт_мөр";
ашигла "файл";
ашигла "систем";

ашигла "лексер.mn";
ашигла "кодген.mn";

// ================= module loader =================

// does буф match keyword түлхүүр at byte position п (bounded by буф_урт)?
функц эхэлдэг(буф мөр, п тоо64, түлхүүр мөр, буф_урт тоо64) -> тоо64 {
    зарла у: тоо64 = мөр_урт(түлхүүр);
    хэрэв п + у > буф_урт бол { буц 0; }
    зарла и: тоо64 = 0;
    давтах и < у бол {
        хэрэв байт(буф, п + и) != байт(түлхүүр, и) бол { буц 0; }
        и = и + 1;
    }
    буц 1;
}

// append every byte of эх_с into зорилго at поз; return the new position
функц хуулах(зорилго мөр, поз тоо64, эх_с мөр) -> тоо64 {
    зарла и: тоо64 = 0;
    зарла у: тоо64 = мөр_урт(эх_с);
    давтах и < у бол {
        байт_тавих(зорилго, поз, байт(эх_с, и));
        поз = поз + 1;
        и = и + 1;
    }
    буц поз;
}

// Build the combined source in `эх`: for each `ашигла "<path>.mn"` in the
// main file, splice the module's source in first, then the main file itself.
// Std-library imports (bare names) are left for the C runtime at link time.
функц эх_ачаалах(зам мөр) -> хоосон {
    зарла гол: мөр = файл_унших_бүтэн(зам);
    зарла гол_урт: тоо64 = мөр_урт(гол);

    // directory prefix of зам, up to and including the last '/'
    зарла зам_урт: тоо64 = мөр_урт(зам);
    зарла зүсэлт: тоо64 = 0;
    зарла и: тоо64 = 0;
    давтах и < зам_урт бол {
        хэрэв байт(зам, и) == 47 бол { зүсэлт = и + 1; }
        и = и + 1;
    }

    эх = мөр_шинэ(6000000);
    зарла поз: тоо64 = 0;

    и = 0;
    давтах и < гол_урт бол {
        хэрэв эхэлдэг(гол, и, "ашигла", гол_урт) == 1 бол {
            // opening quote
            зарла ж: тоо64 = и + 1;
            давтах ж < гол_урт бол {
                хэрэв байт(гол, ж) == 34 бол { зогс; }
                ж = ж + 1;
            }
            ж = ж + 1;
            зарла нэр_э: тоо64 = ж;
            давтах ж < гол_урт бол {
                хэрэв байт(гол, ж) == 34 бол { зогс; }
                ж = ж + 1;
            }
            зарла нэр_т: тоо64 = ж;   // index of the closing quote
            // local module iff the path ends with ".mn"
            хэрэв нэр_т - нэр_э > 3 бол {
            хэрэв байт(гол, нэр_т - 3) == 46 бол {
            хэрэв байт(гол, нэр_т - 2) == 109 бол {
            хэрэв байт(гол, нэр_т - 1) == 110 бол {
                зарла зб: мөр = мөр_шинэ(512);
                зарла к: тоо64 = 0;
                зарла д: тоо64 = 0;
                давтах д < зүсэлт бол {
                    байт_тавих(зб, к, байт(зам, д));
                    к = к + 1;
                    д = д + 1;
                }
                д = нэр_э;
                давтах д < нэр_т бол {
                    байт_тавих(зб, к, байт(гол, д));
                    к = к + 1;
                    д = д + 1;
                }
                байт_тавих(зб, к, 0);
                зарла модуль: мөр = файл_унших_бүтэн(зб);
                поз = хуулах(эх, поз, модуль);
                байт_тавих(эх, поз, 10);   // separate modules with a newline
                поз = поз + 1;
            }}}}
            и = нэр_т;
        }
        эсвэл { и = и + 1; }
    }

    // finally splice in the main file itself
    поз = хуулах(эх, поз, гол);
    эх_урт = поз;
    буц;
}

// ================= driver =================

функц үндсэн() -> тоо {
    хэрэв аргумент_тоо() < 2 бол {
        мөр_хэвлэх("хэрэглээ: mc <файл.mn>\n");
        буц 2;
    }

    эх_ачаалах(аргумент(1));

    // allocate tables and buffers
    фн_эхлэл = шинэ тоо64[1024];
    фн_төгс = шинэ тоо64[1024];
    гл_эхлэл = шинэ тоо64[1024];
    гл_төгс = шинэ тоо64[1024];
    гл_массив = шинэ тоо64[1024];
    ло_эхлэл = шинэ тоо64[512];
    ло_төгс = шинэ тоо64[512];
    гарц = мөр_шинэ(4000000);
    родата = мөр_шинэ(1000000);
    гб = 0;
    рб = 0;
    фн_тоо = 0;
    гл_тоо = 0;
    стр_тоо = 0;
    шошго = 0;
    давталт_төгс = 0;

    урьдчилах();

    // header: extern declarations for the C runtime symbols we call,
    // then the entry stub
    гарга(".text\n");
    гарга(".extern _monAlloc\n.extern _khevle\n.extern _mqr_khevlekh\n");
    гарга(".extern _mqr_urt\n.extern _bayt\n.extern _bayt_tavikh\n.extern _mqr_shine\n");
    гарга(".extern _fayl_unshikh_bwten\n.extern _fayl_bichikh\n");
    гарга(".extern _argumyent\n.extern _argumyent_too\n");
    гарга(".globl _main\n_main:\n\tpushq %rbp\n\tmovq %rsp, %rbp\n");
    зарла гол_идх: тоо64 = 0;
    зарла и: тоо64 = 0;
    давтах и < фн_тоо бол {
        хэрэв муж_тэнцүү(фн_эхлэл[и], фн_төгс[и], "үндсэн") == 1 бол { гол_идх = и; }
        и = и + 1;
    }
    гарга("\tcall _f");
    гарга_тоо(гол_идх);
    гарга("\n\tmovq %rbp, %rsp\n\tpopq %rbp\n\tret\n");

    // compile: second pass
    байр = 0;
    дараах();
    давтах т_төрөл != 0 бол {
        хэрэв кв("ашигла") == 1 бол {
            давтах т_төрөл != 12 бол { дараах(); }
            дараах();  // consume ;
        }
        эсвэл хэрэв кв("функц") == 1 бол {
            комп_функц();  // leaves current = token after }
        }
        эсвэл хэрэв кв("зарла") == 1 бол {
            давтах т_төрөл != 12 бол { дараах(); }
            дараах();  // consume ;
        }
        эсвэл { дараах(); }
    }

    // .data for globals
    гарга(".data\n");
    и = 0;
    давтах и < гл_тоо бол {
        гарга("_g");
        гарга_тоо(и);
        гарга(":\n\t.quad 0\n");
        и = и + 1;
    }

    // rodata (string literals)
    хэрэв стр_тоо > 0 бол {
        гарга(".section __TEXT,__cstring,cstring_literals\n");
        // родата already holds ".LSn:\n\t.byte ...\n" text
        и = 0;
        давтах и < рб бол {
            гарга_т(байт(родата, и));
            и = и + 1;
        }
    }

    файл_бичих("out.s", гарц);
    буц 0;
}
