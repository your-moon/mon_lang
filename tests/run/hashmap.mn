// hash map written in mon_lang itself (selfhost/хүснэгт.mn):
// insert, overwrite, lookup, membership, count
// шалгах: гаралт "100 3 1 0 3\n"
ашигла "modules/хүснэгт.mn";

функц үндсэн() -> тоо {
    зарла х: Хүснэгт = шинэХүснэгт();
    х.тавих("нэг", 1);
    х.тавих("хоёр", 2);
    х.тавих("гурав", 3);
    х.тавих("нэг", 100);

    хэвлэ(х.авах("нэг"));
    мөр_хэвлэх(" ");
    хэвлэ(х.авах("гурав"));
    мөр_хэвлэх(" ");
    хэвлэ(х.байгааЮу("хоёр"));
    мөр_хэвлэх(" ");
    хэвлэ(х.байгааЮу("байхгүй"));
    мөр_хэвлэх(" ");
    хэвлэ(х.элементТоо);
    мөр_хэвлэх("\n");
    буц 0;
}
