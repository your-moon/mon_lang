// хуваарь.mn — шугаман-скан регистр хуваарилалт (Poletto & Sarkar).
//
// Амьдрах интервалуудыг эхлэлээр нь дараалуулан скан хийж, интервал бүрт
// машины регистр оноон, регистр дуусвал (энэ хялбар хувилбарт) тухайн темпийг
// стек рүү асгана (spill). Интервал дуусахад регистрийг чөлөөлдөг тул зэрэг
// амьд утгууд хэзээ ч нэг регистрийг хуваалцахгүй — иймд хуваарилалт үргэлж зөв.

бүтэц Хуваарь {
    темп: тоо,      // темп id
    регистр: тоо,   // 0..рег_тоо-1, эсвэл -1 (асгасан)
    байр: тоо,      // асгасан бол стек нүдний индекс, эс бол -1
}

хэрэгжүүл Функц {
    // хуваарилах — темп бүрт регистр эсвэл стек нүд оноож буцаана
    // (урт = темп_тоо, темп id-гээр индексжинэ).
    функц хуваарилах(өөрөө, интервал Интервал[], рег_тоо тоо) -> Хуваарь[] {
        зарла н: тоо = өөрөө.темп_тоо;
        зарла хув: Хуваарь[];
        хув = шинэ Хуваарь[н];
        зарла и: тоо = 0;
        давтах и < н бол {
            зарла х: Хуваарь;
            х.темп = и;
            х.регистр = 0 - 1;
            х.байр = 0 - 1;
            хув[и] = х;
            и = и + 1;
        }

        // рег_эзэн[r] = уг регистрийг эзэмшиж буй темп id (эс бол -1)
        зарла рег_эзэн: тоо64[];
        рег_эзэн = шинэ тоо64[рег_тоо];
        и = 0;
        давтах и < рег_тоо бол {
            рег_эзэн[и] = 0 - 1;
            и = и + 1;
        }

        зарла дараа_байр: тоо = 0;

        // темпүүдийг эхлэлийн дарааллаар (шулуун IR-т темп id = эхлэлийн дараалал)
        зарла т: тоо = 0;
        давтах т < н бол {
            зарла эх: тоо = интервал[т].эхлэл;
            хэрэв эх >= 0 бол {
                // хугацаа дууссан интервалуудын регистрийг чөлөөл
                зарла r: тоо = 0;
                давтах r < рег_тоо бол {
                    зарла эз: тоо = рег_эзэн[r];
                    хэрэв эз >= 0 бол {
                        хэрэв интервал[эз].төгс < эх бол { рег_эзэн[r] = 0 - 1; }
                    }
                    r = r + 1;
                }
                // чөлөөт регистр хай
                зарла олдсон: тоо = 0 - 1;
                r = 0;
                давтах r < рег_тоо бол {
                    хэрэв рег_эзэн[r] < 0 бол {
                        хэрэв олдсон < 0 бол { олдсон = r; }
                    }
                    r = r + 1;
                }
                хэрэв олдсон >= 0 бол {
                    рег_эзэн[олдсон] = т;
                    хув[т].регистр = олдсон;
                } эсвэл {
                    // регистр дууссан — стек нүд оноож асга
                    хув[т].байр = дараа_байр;
                    дараа_байр = дараа_байр + 1;
                }
            }
            т = т + 1;
        }
        буц хув;
    }
}
