// mc: (2 + 3) * 4 -ийн IR-т 2 регистрээр шугаман-скан хуваарилалт
// t2 нь t0,t1-тэй зэрэг амьд тул регистр дуусаж асгагдана
// t2: регистр=-1 байр=0; t3: регистр=0; t4: регистр=1
// шалгах: гаралт "-1 0 0 1\n"
ашигла "../../mc/ир";

функц үндсэн() -> тоо {
    зарла ф: Функц;
    ф.эхлүүл();
    зарла т0: тоо = ф.имм(2);
    зарла т1: тоо = ф.имм(3);
    зарла т2: тоо = ф.хоёр(Үйлдэл.НЭМ, т0, т1);
    зарла т3: тоо = ф.имм(4);
    зарла т4: тоо = ф.хоёр(Үйлдэл.ҮРЖ, т2, т3);
    ф.буцаа(т4);

    зарла инт: Интервал[];
    инт = ф.амьдрал();
    зарла хув: Хуваарь[];
    хув = ф.хуваарилах(инт, 2);
    хэвлэ(хув[2].регистр); мөр_хэвлэх(" ");
    хэвлэ(хув[2].байр); мөр_хэвлэх(" ");
    хэвлэ(хув[3].регистр); мөр_хэвлэх(" ");
    хэвлэ(хув[4].регистр);
    мөр_хэвлэх("\n");
    буц 0;
}
