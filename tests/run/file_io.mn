// self-hosting kit: file write/read roundtrip, strlen, byte access
// шалгах: гаралт "8 209 мөр-бичсэн 19\n"
ашигла "тэмдэгт_мөр";
ашигла "файл";
функц үндсэн() -> тоо {
    зарла с: мөр = "сайн";
    хэвлэ(мөр_урт(с));
    мөр_хэвлэх(" ");
    хэвлэ(байт(с, 0));
    мөр_хэвлэх(" ");

    файл_бичих("/tmp/mon_io_test.txt", "мөр-бичсэн");
    зарла агуулга: мөр = файл_унших_бүтэн("/tmp/mon_io_test.txt");
    мөр_хэвлэх(агуулга);
    мөр_хэвлэх(" ");
    хэвлэ(мөр_урт(агуулга));
    мөр_хэвлэх("\n");
    буц 0;
}
