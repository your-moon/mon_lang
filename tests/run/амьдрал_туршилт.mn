// mc: (2 + 3) * 4 -ийн IR дээрх амьдрал шинжилгээ
// заавар: 0:copi2(t0) 1:copi3(t1) 2:add(t2=t0+t1) 3:copi4(t3) 4:mul(t4=t2*t3) 5:ret t4
// t0: [0,2], t1: [1,2], t2: [2,4], t3: [3,4], t4: [4,5]
// шалгах: гаралт "0 2 2 4 4 5\n"
ашигла "../../mc/ир";

функц үндсэн() -> тоо {
    зарла ф: Функц;
    ф.эхлүүл();
    зарла т0: тоо = ф.имм(2);
    зарла т1: тоо = ф.имм(3);
    зарла т2: тоо = ф.хоёр(О_НЭМ, т0, т1);
    зарла т3: тоо = ф.имм(4);
    зарла т4: тоо = ф.хоёр(О_ҮРЖ, т2, т3);
    ф.буцаа(т4);

    зарла инт: Интервал[];
    инт = ф.амьдрал();
    хэвлэ(инт[0].эхлэл); мөр_хэвлэх(" "); хэвлэ(инт[0].төгс); мөр_хэвлэх(" ");
    хэвлэ(инт[2].эхлэл); мөр_хэвлэх(" "); хэвлэ(инт[2].төгс); мөр_хэвлэх(" ");
    хэвлэ(инт[4].эхлэл); мөр_хэвлэх(" "); хэвлэ(инт[4].төгс);
    мөр_хэвлэх("\n");
    буц 0;
}
