// self-hosting kit: file write/read roundtrip, strlen, byte access
// шалгах: гаралт "8 209 мөр-бичсэн 19\n"
функц үндсэн() -> тоо {
    зарла с: мөр = "сайн";
    хэвлэ(мөрУрт(с));
    мөр_хэвлэх(" ");
    хэвлэ(байт(с, 0));
    мөр_хэвлэх(" ");

    файлБичих("/tmp/mon_io_test.txt", "мөр-бичсэн");
    зарла агуулга: мөр = файлУншихБүтэн("/tmp/mon_io_test.txt");
    мөр_хэвлэх(агуулга);
    мөр_хэвлэх(" ");
    хэвлэ(мөрУрт(агуулга));
    мөр_хэвлэх("\n");
    буц 0;
}
