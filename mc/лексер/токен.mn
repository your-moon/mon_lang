// токен.mn — mc-ийн лексерийн гаргадаг нэгж ба токен төрлүүд.
//
// Токен бол эх сурвалж дахь байт мужийг (эхлэл..төгс) заасан бүтэц; тоо ба
// тэмдэгт литералын хувьд `утга` талбарт тоон утгыг хадгална.

// ---- токен төрлүүд ----
зарла Т_ТӨГС: тоо = 0;    // файлын төгсгөл
зарла Т_ТОО: тоо = 1;     // тооны литерал
зарла Т_НЭР: тоо = 2;     // танигч (identifier)
зарла Т_МӨР: тоо = 3;     // мөрийн литерал
зарла Т_НЭЭХ: тоо = 4;    // (
зарла Т_ХААХ: тоо = 5;    // )
зарла Т_ФИГНЭЭХ: тоо = 6; // {
зарла Т_ФИГХААХ: тоо = 7; // }
зарла Т_ТАСЛАЛ: тоо = 8;  // ,
зарла Т_ЦЭГТ: тоо = 9;    // ;
зарла Т_НЭМЭХ: тоо = 10;  // +
зарла Т_ХАСАХ: тоо = 11;  // -
зарла Т_ҮРЖ: тоо = 12;    // *
зарла Т_ХУВААХ: тоо = 13; // /
зарла Т_ОНОО: тоо = 14;   // =
зарла Т_ТЭНЦ: тоо = 15;   // ==
зарла Т_БАГА: тоо = 16;      // <
зарла Т_ИХ: тоо = 17;        // >
зарла Т_БАГАТЭНЦ: тоо = 18;  // <=
зарла Т_ИХТЭНЦ: тоо = 19;    // >=
зарла Т_ҮГҮЙТЭНЦ: тоо = 20;  // !=
зарла Т_СУМ: тоо = 21;       // ->
зарла Т_ХОЁРЦЭГ: тоо = 22;   // :

// ---- Токен бүтэц ----
бүтэц Токен {
    төрөл: тоо,   // дээрх Т_* төрлүүдийн нэг
    эхлэл: тоо,   // эх сурвалж дахь эхлэх байт
    төгс: тоо,    // эх сурвалж дахь дуусах байт (сүүлийн байтын дараа)
    утга: тоо,    // тоон/тэмдэгт литералын утга
}

// цифр_үү — б нь ASCII цифр эсэхийг шалгана.
функц цифр_үү(б тоо) -> тоо {
    хэрэв б >= 48 бол { хэрэв б <= 57 бол { буц 1; } }
    буц 0;
}

// үсэг_үү — б нь танигчийн үсэг (ASCII үсэг, '_', эсвэл Юникод) эсэхийг шалгана.
функц үсэг_үү(б тоо) -> тоо {
    хэрэв б >= 97 бол { хэрэв б <= 122 бол { буц 1; } }
    хэрэв б >= 65 бол { хэрэв б <= 90 бол { буц 1; } }
    хэрэв б == 95 бол { буц 1; }
    хэрэв б >= 128 бол { буц 1; }
    буц 0;
}
