// mc лексер багц: жижиг эх сурвалжийг токенчилж, төрлүүдийг хэвлэнэ
// шалгах: гаралт "2 4 1 8 1 5 10 1 0\n"
ашигла "../../mc/лексер";

функц үндсэн() -> тоо {
    зарла у: Уншигч;
    у.эхлүүл("нэм(12, 3) + 4");
    давтах 1 == 1 бол {
        зарла т: Токен;
        т = у.дараах();
        хэвлэ(т.төрөл);
        хэрэв т.төрөл == Т_ТӨГС бол { зогс; }
        мөр_хэвлэх(" ");
    }
    мөр_хэвлэх("\n");
    буц 0;
}
