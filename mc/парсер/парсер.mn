// парсер.mn — токен урсгалаас хийсвэр синтакс мод (AST) байгуулна.
//
// Рекурсив-уруудах парсер: Парсер бүтэц лексерийг (Уншигч) болон урд талын
// хоёр токеныг (одоо, дараагийн) хадгална. Түлхүүр үгсийг лексер тусад нь
// ялгадаггүй тул `кв` метод одоогийн танигчийг түлхүүр үгтэй харьцуулна.

ашигла "../лексер";
ашигла "тэмдэгт_мөр";

бүтэц Парсер {
    у: Уншигч,        // лексер
    одоо: Токен,      // одоогийн токен
    дараагийн: Токен, // нэг токен урьдчилан харах
}

хэрэгжүүл Парсер {
    функц эхлүүл(өөрөө, эх мөр) -> хоосон {
        зарла ш: Уншигч;
        ш.эхлүүл(эх);
        өөрөө.у = ш;
        өөрөө.одоо = өөрөө.у.дараах();
        өөрөө.дараагийн = өөрөө.у.дараах();
        буц;
    }

    функц дараах(өөрөө) -> хоосон {
        өөрөө.одоо = өөрөө.дараагийн;
        өөрөө.дараагийн = өөрөө.у.дараах();
        буц;
    }

    функц төрөл(өөрөө) -> тоо { буц өөрөө.одоо.төрөл; }
    функц дэд(өөрөө) -> тоо { буц өөрөө.дараагийн.төрөл; }

    // одоогийн танигч түлхүүр үг к мөн эсэх
    функц кв(өөрөө, к мөр) -> тоо {
        хэрэв өөрөө.төрөл() != Т_НЭР бол { буц 0; }
        зарла э: тоо = өөрөө.одоо.эхлэл;
        зарла т: тоо = өөрөө.одоо.төгс;
        зарла у: тоо = мөр_урт(к);
        хэрэв (т - э) != у бол { буц 0; }
        зарла и: тоо = 0;
        давтах и < у бол {
            хэрэв байт(өөрөө.у.эх, э + и) != байт(к, и) бол { буц 0; }
            и = и + 1;
        }
        буц 1;
    }

    // ---- илэрхийллүүд ----

    // анхдагч := тоо | нэр | нэр '(' аргументууд ')' | '(' илэрхийлэл ')'
    функц анхдагч(өөрөө) -> Зангилаа {
        хэрэв өөрөө.төрөл() == Т_ТОО бол {
            зарла з: Зангилаа;
            з = зг(З_ТОО);
            з.утга = өөрөө.одоо.утга;
            өөрөө.дараах();
            буц з;
        }
        хэрэв өөрөө.төрөл() == Т_НЭР бол {
            зарла нэ: тоо = өөрөө.одоо.эхлэл;
            зарла нт: тоо = өөрөө.одоо.төгс;
            хэрэв өөрөө.дэд() == Т_НЭЭХ бол {
                зарла з: Зангилаа;
                з = зг(З_ДУУДЛАГА);
                з.нэр_э = нэ;
                з.нэр_т = нт;
                жагс_эхлүүл(з);
                өөрөө.дараах();  // нэр
                өөрөө.дараах();  // (
                хэрэв өөрөө.төрөл() != Т_ХААХ бол {
                    жагс_нэмэх(з, өөрөө.илэрхийлэл());
                    давтах өөрөө.төрөл() == Т_ТАСЛАЛ бол {
                        өөрөө.дараах();
                        жагс_нэмэх(з, өөрөө.илэрхийлэл());
                    }
                }
                өөрөө.дараах();  // )
                буц з;
            }
            зарла з: Зангилаа;
            з = зг(З_НЭР);
            з.нэр_э = нэ;
            з.нэр_т = нт;
            өөрөө.дараах();
            буц з;
        }
        хэрэв өөрөө.төрөл() == Т_НЭЭХ бол {
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = өөрөө.илэрхийлэл();
            өөрөө.дараах();  // )
            буц з;
        }
        зарла э: Зангилаа;
        э = зг(З_ТОО);
        өөрөө.дараах();
        буц э;
    }

    // гишүүн := анхдагч (('*'|'/') анхдагч)*
    функц гишүүн(өөрөө) -> Зангилаа {
        зарла зүүн: Зангилаа;
        зүүн = өөрөө.анхдагч();
        давтах өөрөө.төрөл() == Т_ҮРЖ || өөрөө.төрөл() == Т_ХУВААХ бол {
            зарла оп: тоо = өөрөө.төрөл();
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = зг(З_ХОЁР);
            з.утга = оп;
            з.а = зүүн;
            з.б = өөрөө.анхдагч();
            зүүн = з;
        }
        буц зүүн;
    }

    // нэмэлт := гишүүн (('+'|'-') гишүүн)*
    функц нэмэлт(өөрөө) -> Зангилаа {
        зарла зүүн: Зангилаа;
        зүүн = өөрөө.гишүүн();
        давтах өөрөө.төрөл() == Т_НЭМЭХ || өөрөө.төрөл() == Т_ХАСАХ бол {
            зарла оп: тоо = өөрөө.төрөл();
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = зг(З_ХОЁР);
            з.утга = оп;
            з.а = зүүн;
            з.б = өөрөө.гишүүн();
            зүүн = з;
        }
        буц зүүн;
    }

    // илэрхийлэл := нэмэлт (харьцуулах нэмэлт)*
    функц илэрхийлэл(өөрөө) -> Зангилаа {
        зарла зүүн: Зангилаа;
        зүүн = өөрөө.нэмэлт();
        давтах өөрөө.төрөл() == Т_ТЭНЦ || өөрөө.төрөл() == Т_ҮГҮЙТЭНЦ ||
               өөрөө.төрөл() == Т_БАГА || өөрөө.төрөл() == Т_ИХ ||
               өөрөө.төрөл() == Т_БАГАТЭНЦ || өөрөө.төрөл() == Т_ИХТЭНЦ бол {
            зарла оп: тоо = өөрөө.төрөл();
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = зг(З_ХОЁР);
            з.утга = оп;
            з.а = зүүн;
            з.б = өөрөө.нэмэлт();
            зүүн = з;
        }
        буц зүүн;
    }

    // ---- мэдэгдлүүд ----

    функц мэдэгдэл(өөрөө) -> Зангилаа {
        хэрэв өөрөө.кв("буц") == 1 бол {
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = зг(З_БУЦ);
            хэрэв өөрөө.төрөл() != Т_ЦЭГТ бол {
                з.а = өөрөө.илэрхийлэл();
            }
            өөрөө.дараах();  // ;
            буц з;
        }
        хэрэв өөрөө.кв("хэрэв") == 1 бол {
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = зг(З_ХЭРЭВ);
            з.а = өөрөө.илэрхийлэл();
            өөрөө.дараах();  // бол
            з.б = өөрөө.блок();
            хэрэв өөрөө.кв("эсвэл") == 1 бол {
                өөрөө.дараах();
                з.в = өөрөө.блок();
            }
            буц з;
        }
        хэрэв өөрөө.кв("давтах") == 1 бол {
            өөрөө.дараах();
            зарла з: Зангилаа;
            з = зг(З_ДАВТАХ);
            з.а = өөрөө.илэрхийлэл();
            өөрөө.дараах();  // бол
            з.б = өөрөө.блок();
            буц з;
        }
        хэрэв өөрөө.кв("зарла") == 1 бол {
            өөрөө.дараах();  // нэр рүү
            зарла з: Зангилаа;
            з = зг(З_ЗАРЛА);
            з.нэр_э = өөрөө.одоо.эхлэл;
            з.нэр_т = өөрөө.одоо.төгс;
            өөрөө.дараах();  // нэр
            өөрөө.дараах();  // :
            өөрөө.дараах();  // төрөл
            хэрэв өөрөө.төрөл() == Т_ОНОО бол {
                өөрөө.дараах();
                з.а = өөрөө.илэрхийлэл();
            }
            өөрөө.дараах();  // ;
            буц з;
        }
        // оноолт: нэр '=' ...
        хэрэв өөрөө.төрөл() == Т_НЭР бол {
            хэрэв өөрөө.дэд() == Т_ОНОО бол {
                зарла з: Зангилаа;
                з = зг(З_ОНОО);
                з.нэр_э = өөрөө.одоо.эхлэл;
                з.нэр_т = өөрөө.одоо.төгс;
                өөрөө.дараах();  // нэр
                өөрөө.дараах();  // =
                з.а = өөрөө.илэрхийлэл();
                өөрөө.дараах();  // ;
                буц з;
            }
        }
        // илэрхийллийн мэдэгдэл
        зарла з: Зангилаа;
        з = зг(З_ИЛЭРХ);
        з.а = өөрөө.илэрхийлэл();
        өөрөө.дараах();  // ;
        буц з;
    }

    // блок := '{' мэдэгдэл* '}'
    функц блок(өөрөө) -> Зангилаа {
        зарла з: Зангилаа;
        з = зг(З_БЛОК);
        жагс_эхлүүл(з);
        өөрөө.дараах();  // {
        давтах өөрөө.төрөл() != Т_ФИГХААХ бол {
            хэрэв өөрөө.төрөл() == Т_ТӨГС бол { зогс; }
            жагс_нэмэх(з, өөрөө.мэдэгдэл());
        }
        өөрөө.дараах();  // }
        буц з;
    }

    // функц := 'функц' нэр '(' параметрүүд ')' '->' төрөл блок
    функц функц_задлах(өөрөө) -> Зангилаа {
        өөрөө.дараах();  // нэр рүү
        зарла з: Зангилаа;
        з = зг(З_ФУНКЦ);
        з.нэр_э = өөрөө.одоо.эхлэл;
        з.нэр_т = өөрөө.одоо.төгс;
        жагс_эхлүүл(з);
        өөрөө.дараах();  // нэр
        өөрөө.дараах();  // (
        хэрэв өөрөө.төрөл() != Т_ХААХ бол {
            зарла п: Зангилаа;
            п = зг(З_НЭР);
            п.нэр_э = өөрөө.одоо.эхлэл;
            п.нэр_т = өөрөө.одоо.төгс;
            жагс_нэмэх(з, п);
            өөрөө.дараах();  // нэр
            өөрөө.дараах();  // төрөл
            давтах өөрөө.төрөл() == Т_ТАСЛАЛ бол {
                өөрөө.дараах();  // ,
                зарла п2: Зангилаа;
                п2 = зг(З_НЭР);
                п2.нэр_э = өөрөө.одоо.эхлэл;
                п2.нэр_т = өөрөө.одоо.төгс;
                жагс_нэмэх(з, п2);
                өөрөө.дараах();  // нэр
                өөрөө.дараах();  // төрөл
            }
        }
        өөрөө.дараах();  // )
        // '->' төрөл-ийг блок хүртэл алгасах
        давтах өөрөө.төрөл() != Т_ФИГНЭЭХ бол {
            хэрэв өөрөө.төрөл() == Т_ТӨГС бол { зогс; }
            өөрөө.дараах();
        }
        з.б = өөрөө.блок();
        буц з;
    }

    // програм := функц*
    функц програм(өөрөө) -> Зангилаа {
        зарла з: Зангилаа;
        з = зг(З_ПРОГ);
        жагс_эхлүүл(з);
        давтах өөрөө.төрөл() != Т_ТӨГС бол {
            хэрэв өөрөө.кв("функц") == 1 бол {
                жагс_нэмэх(з, өөрөө.функц_задлах());
            } эсвэл {
                өөрөө.дараах();  // дээд түвшний бусад зүйлийг алгасах
            }
        }
        буц з;
    }
}
