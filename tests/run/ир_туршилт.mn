// mc IR багц: (2 + 3) * 4 -ийн IR байгуулж шалгана
// заавар[2] нь нэмэх (О_НЭМ=1), заавар[4] нь үржих (О_ҮРЖ=3)
// шалгах: гаралт "6 1 3 5\n"
ашигла "../../mc/ир";

функц үндсэн() -> тоо {
    зарла ф: Функц;
    ф.эхлүүл();
    зарла т2: тоо = ф.имм(2);
    зарла т3: тоо = ф.имм(3);
    зарла нийл: тоо = ф.хоёр(О_НЭМ, т2, т3);
    зарла т4: тоо = ф.имм(4);
    зарла үр: тоо = ф.хоёр(О_ҮРЖ, нийл, т4);
    ф.буцаа(үр);
    хэвлэ(ф.зтоо); мөр_хэвлэх(" ");        // 6 instructions
    хэвлэ(ф.заавар[2].үйлдэл); мөр_хэвлэх(" "); // add = О_НЭМ = 1... wait
    хэвлэ(ф.заавар[4].үйлдэл); мөр_хэвлэх(" "); // mul = О_ҮРЖ = 3
    хэвлэ(ф.темп_тоо);                      // 5 temps
    мөр_хэвлэх("\n");
    буц 0;
}
