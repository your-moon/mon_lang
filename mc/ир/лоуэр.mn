// лоуэр.mn — хийсвэр синтакс модыг (AST) SSA IR болгон бууруулна.
//
// Одоохондоо илэрхийллүүдийг (тоо, хоёрлосон үйлдэл) бууруулна; мэдэгдэл ба
// урсгал хяналтыг дараагийн алхамд нэмнэ. Функц бүтэц дээрх метод хэлбэрээр
// бичсэн тул builder API-г шууд ашиглана.

ашигла "../парсер";

хэрэгжүүл Функц {
    // токен_үйлдэл — лексерийн операторын токеныг IR үйлдэл рүү буулгана.
    функц токен_үйлдэл(өөрөө, тк тоо) -> тоо {
        хэрэв тк == Т_НЭМЭХ бол { буц О_НЭМ; }
        хэрэв тк == Т_ХАСАХ бол { буц О_ХАС; }
        хэрэв тк == Т_ҮРЖ бол { буц О_ҮРЖ; }
        хэрэв тк == Т_ХУВААХ бол { буц О_ХУВ; }
        хэрэв тк == Т_ТЭНЦ бол { буц О_ТЭНЦ; }
        хэрэв тк == Т_ҮГҮЙТЭНЦ бол { буц О_ҮГТЭНЦ; }
        хэрэв тк == Т_БАГА бол { буц О_БАГА; }
        хэрэв тк == Т_ИХ бол { буц О_ИХ; }
        буц О_НЭМ;
    }

    // илэрхийлэл — илэрхийллийн зангилааг бууруулж, үр дүнгийн темпийг буцаана.
    функц илэрхийлэл(өөрөө, зн Зангилаа) -> тоо {
        хэрэв зн.төрөл == З_ТОО бол {
            буц өөрөө.имм(зн.утга);
        }
        хэрэв зн.төрөл == З_ХОЁР бол {
            зарла а: тоо = өөрөө.илэрхийлэл(зн.а);
            зарла б: тоо = өөрөө.илэрхийлэл(зн.б);
            зарла оп: тоо = өөрөө.токен_үйлдэл(зн.утга);
            буц өөрөө.хоёр(оп, а, б);
        }
        // З_НЭР, З_ДУУДЛАГА гэх мэт нь тэмдэгтийн хүснэгт шаардана — дараа нэмнэ.
        буц 0 - 1;
    }
}
