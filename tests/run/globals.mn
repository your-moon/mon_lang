// regression: non-trivial global initializers silently became 0
// шалгах: гаралт "-5 5 8\n"
зарла сөрөг: тоо = -5;
зарла нийлбэр: тоо = 2 + 3;
зарла хувьсах: тоо = 0;

функц үндсэн() -> тоо {
    хэвлэ(сөрөг);
    мөр_хэвлэх(" ");
    хэвлэ(нийлбэр);
    мөр_хэвлэх(" ");
    хувьсах = 8;
    хэвлэ(хувьсах);
    мөр_хэвлэх("\n");
    буц 0;
}
