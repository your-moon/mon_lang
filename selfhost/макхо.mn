// макхо — Mach-O файл бичигч (гадаад хэрэгсэлгүй).
//
// mon_lang дотор бичсэн статик x86_64 Mach-O (LC_UNIXTHREAD) гүйцэтгэгдэх файл
// үүсгэнэ — cc/as/ld хэрэггүй. Энэ бол өөрийгөө-хостлох (self-hosting)-ийн эцсийн
// зорилго болох "гадаад хэрэгсэлгүй" гаралтын суурь. Байт бичихдээ файл_бичих_байт
// ашигладаг тул NUL агуулсан хоёртын өгөгдлийг зөв бичнэ.

ашигла "тэмдэгт_мөр"; // мөр_шинэ, байт, байт_тавих, мөр_урт
ашигла "файл";        // файл_бичих_байт

бүтэц Буф { д: мөр, у: тоо64 }

хэрэгжүүл Буф {
    функц эхлүүл(өөрөө) -> хоосон { өөрөө.д = мөр_шинэ(1048576); өөрөө.у = 0; буц; }
    функц б(өөрөө, в тоо64) -> хоосон { байт_тавих(өөрөө.д, өөрөө.у, в); өөрөө.у = өөрөө.у + 1; буц; }
    функц у32(өөрөө, в тоо64) -> хоосон {
        өөрөө.б(в % 256); өөрөө.б((в / 256) % 256);
        өөрөө.б((в / 65536) % 256); өөрөө.б((в / 16777216) % 256); буц;
    }
    функц у64(өөрөө, в тоо64) -> хоосон { өөрөө.у32(в); өөрөө.у32(в / 4294967296); буц; }
    функц нэр(өөрөө, с мөр) -> хоосон {
        зарла л: тоо64 = мөр_урт(с); зарла и: тоо64 = 0;
        давтах и < 16 бол {
            хэрэв и < л бол { өөрөө.б(байт(с, и)); } эсвэл { өөрөө.б(0); }
            и = и + 1;
        }
        буц;
    }
    функц падто(өөрөө, н тоо64) -> хоосон { давтах өөрөө.у < н бол { өөрөө.б(0); } буц; }
    функц кодбич(өөрөө, с мөр, л тоо64) -> хоосон {
        зарла и: тоо64 = 0; давтах и < л бол { өөрөө.б(байт(с, и)); и = и + 1; } буц;
    }
}

// макхо_бич — `код` (кодурт байт) машины кодыг агуулсан статик x86_64 Mach-O-г
// `зам`-д бичнэ. `оруулга` нь кодын доторх орох цэгийн офсет (ихэвчлэн 0).
функц макхо_бич(зам мөр, код мөр, кодурт тоо64, оруулга тоо64) -> тоо {
    зарла б: Буф; б.эхлүүл();
    зарла хуудас: тоо64 = 4096;
    зарла суурь: тоо64 = 4294967296;
    зарла кодхаяг: тоо64 = суурь + хуудас;
    зарла бичвэрвм: тоо64 = хуудас + кодурт;
    давтах (бичвэрвм % хуудас) != 0 бол { бичвэрвм = бичвэрвм + 1; }

    // mach header
    б.у32(4277009103); // magic 0xfeedfacf
    б.у32(16777223);   // cputype 0x01000007 (x86_64)
    б.у32(2147483651); // cpusubtype 0x80000003
    б.у32(2);          // MH_EXECUTE
    б.у32(3);          // ncmds
    б.у32(408);        // sizeofcmds
    б.у32(1);          // MH_NOUNDEFS
    б.у32(0);

    // __PAGEZERO
    б.у32(25); б.у32(72); б.нэр("__PAGEZERO");
    б.у64(0); б.у64(суурь); б.у64(0); б.у64(0);
    б.у32(0); б.у32(0); б.у32(0); б.у32(0);

    // __TEXT + __text section
    б.у32(25); б.у32(152); б.нэр("__TEXT");
    б.у64(суурь); б.у64(бичвэрвм); б.у64(0); б.у64(хуудас + кодурт);
    б.у32(5); б.у32(5); б.у32(1); б.у32(0);
    б.нэр("__text"); б.нэр("__TEXT");
    б.у64(кодхаяг); б.у64(кодурт); б.у32(хуудас); б.у32(4);
    б.у32(0); б.у32(0); б.у32(2147484672); // flags 0x80000400 (pure instructions)
    б.у32(0); б.у32(0); б.у32(0);

    // LC_UNIXTHREAD (x86_THREAD_STATE64, rip нь 16-р индекст)
    б.у32(5); б.у32(184); б.у32(4); б.у32(42);
    зарла и: тоо64 = 0;
    давтах и < 21 бол {
        хэрэв и == 16 бол { б.у64(кодхаяг + оруулга); } эсвэл { б.у64(0); }
        и = и + 1;
    }

    б.падто(хуудас);
    б.кодбич(код, кодурт);
    буц файл_бичих_байт(зам, б.д, б.у);
}
