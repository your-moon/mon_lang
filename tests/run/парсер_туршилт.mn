// mc парсер багц: функц задалж, AST-ийн бүтцийг шалгана
// шалгах: гаралт "1 2 1 10\n"
ашигла "../../mc/парсер";

функц үндсэн() -> тоо {
    зарла п: Парсер;
    п.эхлүүл("функц нэм(а тоо, б тоо) -> тоо { буц а + б; }");
    зарла пр: Зангилаа;
    пр = п.програм();
    хэвлэ(пр.жтоо); мөр_хэвлэх(" ");
    зарла ф: Зангилаа;
    ф = пр.жагс[0];
    хэвлэ(ф.жтоо); мөр_хэвлэх(" ");
    зарла бие: Зангилаа;
    бие = ф.б;
    хэвлэ(бие.жтоо); мөр_хэвлэх(" ");
    зарла бу: Зангилаа;
    бу = бие.жагс[0];
    зарла илэрх: Зангилаа;
    илэрх = бу.а;
    хэвлэ(илэрх.утга);
    мөр_хэвлэх("\n");
    буц 0;
}
