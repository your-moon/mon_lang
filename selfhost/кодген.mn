// кодген.mn — mc-ийн код үүсгэгч ба симбол хүснэгт модуль.
//
// Параллель массив симбол хүснэгт, x86_64 AT&T ассемблер ялгаруулагч,
// илэрхийлэл/мэдэгдэл/функц хөрвүүлэгч. Лексерийн (дараах, кв) дээр тулгуурлана.

// ---- output ----
зарла гарц: мөр;
зарла гб: тоо64;          // output write position
зарла родата: мөр;
зарла рб: тоо64;          // rodata position
зарла стр_тоо: тоо64;     // string literal counter
зарла шошго: тоо64;       // branch label counter

// ---- symbol tables (parallel arrays) ----
зарла фн_эхлэл: тоо64[];  // source byte-range of each function name
зарла фн_төгс: тоо64[];
зарла фн_тоо: тоо64;

зарла гл_эхлэл: тоо64[];  // global names
зарла гл_төгс: тоо64[];
зарла гл_массив: тоо64[]; // element count if array, else 0
зарла гл_тоо: тоо64;

зарла ло_эхлэл: тоо64[];  // locals of the current function
зарла ло_төгс: тоо64[];
зарла ло_тоо: тоо64;
зарла гүн: тоо64;            // expression-stack depth

// ================= helpers: output =================

функц гарга_т(б тоо64) -> хоосон {
    байт_тавих(гарц, гб, б);
    гб = гб + 1;
    буц;
}

функц гарга(с мөр) -> хоосон {
    зарла и: тоо64 = 0;
    зарла у: тоо64 = мөр_урт(с);
    давтах и < у бол {
        гарга_т(байт(с, и));
        и = и + 1;
    }
    буц;
}

функц гарга_тоо(н тоо64) -> хоосон {
    хэрэв н < 0 бол {
        гарга_т(45);
        н = 0 - н;
    }
    хэрэв н == 0 бол {
        гарга_т(48);
        буц;
    }
    зарла буф: тоо64[24];
    зарла к: тоо64 = 0;
    давтах н > 0 бол {
        буф[к] = 48 + (н % 10);
        н = н / 10;
        к = к + 1;
    }
    давтах к > 0 бол {
        к = к - 1;
        гарга_т(буф[к]);
    }
    буц;
}

// ================= symbol tables =================

функц нэр_тэнцүү(а1 тоо64, б1 тоо64, а2 тоо64, б2 тоо64) -> тоо64 {
    хэрэв (б1 - а1) != (б2 - а2) бол { буц 0; }
    зарла и: тоо64 = 0;
    давтах и < (б1 - а1) бол {
        хэрэв байт(эх, а1 + и) != байт(эх, а2 + и) бол { буц 0; }
        и = и + 1;
    }
    буц 1;
}

функц лок_ол(а тоо64, б тоо64) -> тоо64 {
    // search newest-first so a re-declared name shadows the earlier one
    зарла и: тоо64 = ло_тоо;
    давтах и > 0 бол {
        и = и - 1;
        хэрэв нэр_тэнцүү(ло_эхлэл[и], ло_төгс[и], а, б) == 1 бол { буц и; }
    }
    буц 0 - 1;
}

функц лок_нэмэх(а тоо64, б тоо64) -> тоо64 {
    ло_эхлэл[ло_тоо] = а;
    ло_төгс[ло_тоо] = б;
    ло_тоо = ло_тоо + 1;
    буц ло_тоо - 1;
}

функц гл_ол(а тоо64, б тоо64) -> тоо64 {
    зарла и: тоо64 = 0;
    давтах и < гл_тоо бол {
        хэрэв нэр_тэнцүү(гл_эхлэл[и], гл_төгс[и], а, б) == 1 бол { буц и; }
        и = и + 1;
    }
    буц 0 - 1;
}

функц фн_ол(а тоо64, б тоо64) -> тоо64 {
    зарла и: тоо64 = 0;
    давтах и < фн_тоо бол {
        хэрэв нэр_тэнцүү(фн_эхлэл[и], фн_төгс[и], а, б) == 1 бол { буц и; }
        и = и + 1;
    }
    буц 0 - 1;
}

// C symbol for a builtin call, or "" (empty) if the name is a user function
функц гадаад_нэр(а тоо64, б тоо64) -> мөр {
    хэрэв муж_тэнцүү(а, б, "хэвлэ") == 1 бол { буц "_khevle"; }
    хэрэв муж_тэнцүү(а, б, "мөр_хэвлэх") == 1 бол { буц "_mqr_khevlekh"; }
    хэрэв муж_тэнцүү(а, б, "мөр_урт") == 1 бол { буц "_mqr_urt"; }
    хэрэв муж_тэнцүү(а, б, "байт") == 1 бол { буц "_bayt"; }
    хэрэв муж_тэнцүү(а, б, "байт_тавих") == 1 бол { буц "_bayt_tavikh"; }
    хэрэв муж_тэнцүү(а, б, "мөр_шинэ") == 1 бол { буц "_mqr_shine"; }
    хэрэв муж_тэнцүү(а, б, "файл_унших_бүтэн") == 1 бол { буц "_fayl_unshikh_bwten"; }
    хэрэв муж_тэнцүү(а, б, "файл_бичих") == 1 бол { буц "_fayl_bichikh"; }
    хэрэв муж_тэнцүү(а, б, "аргумент") == 1 бол { буц "_argumyent"; }
    хэрэв муж_тэнцүү(а, б, "аргумент_тоо") == 1 бол { буц "_argumyent_too"; }
    буц "";
}

// ================= emit helpers =================

функц түлх() -> хоосон {
    гарга("\tmovq %rax, ");
    гарга_тоо(0 - 400 - 8 * гүн);
    гарга("(%rbp)\n");
    гүн = гүн + 1;
}

функц ав_ракс() -> хоосон {
    гүн = гүн - 1;
    гарга("\tmovq ");
    гарга_тоо(0 - 400 - 8 * гүн);
    гарга("(%rbp), %rax\n");
}

функц ав_рбх() -> хоосон {
    гүн = гүн - 1;
    гарга("\tmovq ");
    гарга_тоо(0 - 400 - 8 * гүн);
    гарга("(%rbp), %r10\n");
}

функц шошго_шинэ() -> тоо64 {
    шошго = шошго + 1;
    буц шошго;
}

// родата text-buffer append helpers
функц род_т(б тоо64) -> хоосон {
    байт_тавих(родата, рб, б);
    рб = рб + 1;
}
функц род(с мөр) -> хоосон {
    зарла и: тоо64 = 0;
    зарла у: тоо64 = мөр_урт(с);
    давтах и < у бол { род_т(байт(с, и)); и = и + 1; }
}
функц род_тоо(н тоо64) -> хоосон {
    хэрэв н == 0 бол { род_т(48); буц; }
    зарла буф: тоо64[24];
    зарла к: тоо64 = 0;
    давтах н > 0 бол { буф[к] = 48 + (н % 10); н = н / 10; к = к + 1; }
    давтах к > 0 бол { к = к - 1; род_т(буф[к]); }
}

// emit the current string token as ".LSn: .byte ...,0", return its index
функц стр_нэмэх() -> тоо64 {
    зарла идх: тоо64 = стр_тоо;
    стр_тоо = стр_тоо + 1;
    род(".LS");
    род_тоо(идх);
    род(":
	.byte ");
    зарла и: тоо64 = т_эхлэл;
    давтах и < т_төгс бол {
        зарла ц: тоо64 = байт(эх, и);
        хэрэв ц == 92 бол {
            и = и + 1;
            зарла э: тоо64 = байт(эх, и);
            хэрэв э == 110 бол { ц = 10; }
            эсвэл хэрэв э == 116 бол { ц = 9; }
            эсвэл хэрэв э == 48 бол { ц = 0; }
            эсвэл { ц = э; }
        }
        род_тоо(ц);
        род(", ");
        и = и + 1;
    }
    род("0
");
    буц идх;
}

// ================= expression compiler =================
// each leaves its result on the expression stack (pushed).

функц комп_илэрхийлэл() -> хоосон  // forward prototype

функц комп_дуудлага(а тоо64, б тоо64) -> хоосон {
    // ident already consumed; current token is '('. compile args.
    дараах();  // consume (
    зарла на: тоо64 = 0;
    давтах т_төрөл != 9 бол {
        комп_илэрхийлэл();
        на = на + 1;
        хэрэв т_төрөл == 13 бол { дараах(); }
    }
    дараах();  // consume )
    // pop args into registers in reverse: last arg is on top
    зарла и: тоо64 = на;
    давтах и > 0 бол {
        и = и - 1;
        гүн = гүн - 1;
        гарга("\tmovq ");
        гарга_тоо(0 - 400 - 8 * гүн);
        гарга("(%rbp), ");
        хэрэв и == 0 бол { гарга("%rdi"); }
        эсвэл хэрэв и == 1 бол { гарга("%rsi"); }
        эсвэл хэрэв и == 2 бол { гарга("%rdx"); }
        эсвэл хэрэв и == 3 бол { гарга("%rcx"); }
        эсвэл хэрэв и == 4 бол { гарга("%r8"); }
        эсвэл { гарга("%r9"); }
        гарга("\n");
    }
    зарла г: мөр = гадаад_нэр(а, б);
    хэрэв мөр_урт(г) > 0 бол {
        гарга("\tcall ");
        гарга(г);
        гарга("\n");
    } эсвэл {
        зарла ф: тоо64 = фн_ол(а, б);
        гарга("\tcall _f");
        гарга_тоо(ф);
        гарга("\n");
    }
    гарга("\tmovq %rax, %rax\n");  // result in rax
    түлх();
}

// load the address of var[index]; leaves address pushed. ident+[  consumed by caller? no.
функц комп_массив_хаяг(лок тоо64, гл тоо64) -> хоосон {
    // emit base pointer into rax, push
    хэрэв лок >= 0 бол {
        гарга("\tmovq ");
        гарга_тоо(0 - 8 - 8 * лок);
        гарга("(%rbp), %rax\n");
    } эсвэл {
        гарга("\tmovq _g");
        гарга_тоо(гл);
        гарга("(%rip), %rax\n");
    }
    түлх();
    дараах();  // consume [
    комп_илэрхийлэл();  // index pushed
    дараах();  // consume ]
    ав_рбх();   // index -> rbx
    ав_ракс();  // base -> rax
    гарга("\tleaq (%rax,%r10,8), %rax\n");
    түлх();
}

функц комп_анхдагч() -> хоосон {
    хэрэв т_төрөл == 1 бол {
        гарга("\tmovq $");
        гарга_тоо(т_тоо);
        гарга(", %rax\n");
        түлх();
        дараах();
    }
    эсвэл хэрэв т_төрөл == 8 бол {
        дараах();
        комп_илэрхийлэл();
        дараах();  // )
    }
    эсвэл хэрэв т_төрөл == 4 бол {
        дараах();
        комп_анхдагч();
        ав_ракс();
        гарга("\tnegq %rax\n");
        түлх();
    }
    эсвэл хэрэв т_төрөл == 21 бол {
        зарла идх: тоо64 = стр_нэмэх();
        гарга("\tleaq .LS");
        гарга_тоо(идх);
        гарга("(%rip), %rax\n");
        түлх();
        дараах();
    }
    эсвэл хэрэв т_төрөл == 2 бол {
        зарла а: тоо64 = т_эхлэл;
        зарла б: тоо64 = т_төгс;
        хэрэв муж_тэнцүү(а, б, "шинэ") == 1 бол {
            дараах();  // consume шинэ
            дараах();  // consume type name
            дараах();  // consume [
            комп_илэрхийлэл();  // element count pushed
            дараах();  // consume ]
            ав_ракс();
            гарга("	imulq $8, %rax
	movq %rax, %rdi
	call _monAlloc
");
            түлх();
            буц;
        }
        дараах();
        хэрэв т_төрөл == 8 бол {
            комп_дуудлага(а, б);
        }
        эсвэл хэрэв т_төрөл == 24 бол {
            зарла лок: тоо64 = лок_ол(а, б);
            зарла гл: тоо64 = гл_ол(а, б);
            комп_массив_хаяг(лок, гл);
            ав_ракс();
            гарга("\tmovq (%rax), %rax\n");
            түлх();
        }
        эсвэл {
            зарла лок: тоо64 = лок_ол(а, б);
            хэрэв лок >= 0 бол {
                гарга("\tmovq ");
                гарга_тоо(0 - 8 - 8 * лок);
                гарга("(%rbp), %rax\n");
            } эсвэл {
                зарла гл: тоо64 = гл_ол(а, б);
                гарга("\tmovq _g");
                гарга_тоо(гл);
                гарга("(%rip), %rax\n");
            }
            түлх();
        }
    }
    эсвэл {
        гарга("\tmovq $0, %rax\n");
        түлх();
    }
}

функц комп_үржих() -> хоосон {
    комп_анхдагч();
    давтах т_төрөл == 5 бол {
        зарла оп: тоо64 = т_төрөл;
        дараах();
        комп_анхдагч();
        ав_рбх();
        ав_ракс();
        хэрэв оп == 5 бол { гарга("\timulq %r10, %rax\n"); }
        түлх();
        // reset оп unused
        оп = оп;
    }
    давтах т_төрөл == 6 бол {
        дараах();
        комп_анхдагч();
        ав_рбх();
        ав_ракс();
        гарга("\tcqo\n\tidivq %r10\n");
        түлх();
    }
    давтах т_төрөл == 7 бол {
        дараах();
        комп_анхдагч();
        ав_рбх();
        ав_ракс();
        гарга("\tcqo\n\tidivq %r10\n\tmovq %rdx, %rax\n");
        түлх();
    }
}

функц комп_нэмэх() -> хоосон {
    комп_үржих();
    давтах т_төрөл == 3 бол {
        дараах();
        комп_үржих();
        ав_рбх();
        ав_ракс();
        гарга("\taddq %r10, %rax\n");
        түлх();
    }
    давтах т_төрөл == 4 бол {
        дараах();
        комп_үржих();
        ав_рбх();
        ав_ракс();
        гарга("\tsubq %r10, %rax\n");
        түлх();
    }
}

функц комп_илэрхийлэл() -> хоосон {
    комп_нэмэх();
    давтах т_төрөл >= 15 бол {
        хэрэв т_төрөл > 20 бол { буц; }
        зарла оп: тоо64 = т_төрөл;
        дараах();
        комп_нэмэх();
        ав_рбх();
        ав_ракс();
        гарга("\tcmpq %r10, %rax\n\tmovq $0, %rax\n");
        хэрэв оп == 15 бол { гарга("\tsete %al\n"); }
        эсвэл хэрэв оп == 16 бол { гарга("\tsetne %al\n"); }
        эсвэл хэрэв оп == 17 бол { гарга("\tsetl %al\n"); }
        эсвэл хэрэв оп == 18 бол { гарга("\tsetg %al\n"); }
        эсвэл хэрэв оп == 19 бол { гарга("\tsetle %al\n"); }
        эсвэл { гарга("\tsetge %al\n"); }
        гарга("\tmovzbq %al, %rax\n");
        түлх();
    }
}

// ================= statements =================

зарла давталт_төгс: тоо64;  // end label of the current loop (for зогс)

функц комп_мэдэгдэл() -> хоосон  // forward
функц комп_блок() -> хоосон  // forward

// assignment target already lexed as ident [а,б]; current token is = or [
функц комп_оноолт(а тоо64, б тоо64) -> хоосон {
    хэрэв т_төрөл == 24 бол {
        зарла лок: тоо64 = лок_ол(а, б);
        зарла гл: тоо64 = гл_ол(а, б);
        комп_массив_хаяг(лок, гл);  // address pushed
        дараах();  // consume =
        комп_илэрхийлэл();  // value pushed
        ав_рбх();   // value
        ав_ракс();  // address
        гарга("\tmovq %r10, (%rax)\n");
    } эсвэл {
        дараах();  // consume =
        комп_илэрхийлэл();
        ав_ракс();
        зарла лок: тоо64 = лок_ол(а, б);
        хэрэв лок >= 0 бол {
            гарга("\tmovq %rax, ");
            гарга_тоо(0 - 8 - 8 * лок);
            гарга("(%rbp)\n");
        } эсвэл {
            зарла гл: тоо64 = гл_ол(а, б);
            гарга("\tmovq %rax, _g");
            гарга_тоо(гл);
            гарга("(%rip)\n");
        }
    }
    дараах();  // consume ;
}

функц комп_мэдэгдэл() -> хоосон {
    хэрэв кв("зарла") == 1 бол {
        дараах();  // -> name
        зарла а: тоо64 = т_эхлэл;
        зарла б: тоо64 = т_төгс;
        зарла идх: тоо64 = лок_нэмэх(а, б);
        дараах();  // -> :
        дараах();  // -> type name
        дараах();  // -> = or [ or ;
        хэрэв т_төрөл == 24 бол {
            // sized local array: alloc N*8
            дараах();  // [
            зарла н: тоо64 = т_тоо;
            дараах();  // N
            дараах();  // ]
            гарга("\tmovq $");
            гарга_тоо(н * 8);
            гарга(", %rdi\n\tcall _monAlloc\n\tmovq %rax, ");
            гарга_тоо(0 - 8 - 8 * идх);
            гарга("(%rbp)\n");
            дараах();  // ;
        }
        эсвэл хэрэв т_төрөл == 14 бол {
            дараах();  // =
            комп_илэрхийлэл();
            ав_ракс();
            гарга("\tmovq %rax, ");
            гарга_тоо(0 - 8 - 8 * идх);
            гарга("(%rbp)\n");
            дараах();  // ;
        }
        эсвэл {
            дараах();  // ;
        }
    }
    эсвэл хэрэв кв("хэрэв") == 1 бол {
        дараах();
        комп_илэрхийлэл();
        ав_ракс();
        зарла эл: тоо64 = шошго_шинэ();
        зарла тг: тоо64 = шошго_шинэ();
        гарга("\tcmpq $0, %rax\n\tje .L");
        гарга_тоо(эл);
        гарга("\n");
        // expect бол then block
        дараах();  // consume бол
        комп_блок();
        гарга("\tjmp .L");
        гарга_тоо(тг);
        гарга("\n.L");
        гарга_тоо(эл);
        гарга(":\n");
        хэрэв кв("эсвэл") == 1 бол {
            дараах();  // consume эсвэл
            хэрэв кв("хэрэв") == 1 бол {
                комп_мэдэгдэл();  // else-if
            } эсвэл {
                комп_блок();
            }
        }
        гарга(".L");
        гарга_тоо(тг);
        гарга(":\n");
    }
    эсвэл хэрэв кв("давтах") == 1 бол {
        дараах();
        зарла эх_ш: тоо64 = шошго_шинэ();
        зарла тг_ш: тоо64 = шошго_шинэ();
        зарла хуучин: тоо64 = давталт_төгс;
        давталт_төгс = тг_ш;
        гарга(".L");
        гарга_тоо(эх_ш);
        гарга(":\n");
        комп_илэрхийлэл();
        ав_ракс();
        гарга("\tcmpq $0, %rax\n\tje .L");
        гарга_тоо(тг_ш);
        гарга("\n");
        дараах();  // consume бол
        комп_блок();
        гарга("\tjmp .L");
        гарга_тоо(эх_ш);
        гарга("\n.L");
        гарга_тоо(тг_ш);
        гарга(":\n");
        давталт_төгс = хуучин;
    }
    эсвэл хэрэв кв("буц") == 1 бол {
        дараах();
        хэрэв т_төрөл == 12 бол {
            гарга("\tmovq $0, %rax\n");
        } эсвэл {
            комп_илэрхийлэл();
            ав_ракс();
        }
        гарга("\tmovq %rbp, %rsp\n\tpopq %rbp\n\tret\n");
        дараах();  // ;
    }
    эсвэл хэрэв кв("зогс") == 1 бол {
        дараах();
        гарга("\tjmp .L");
        гарга_тоо(давталт_төгс);
        гарга("\n");
        дараах();  // ;
    }
    эсвэл хэрэв т_төрөл == 2 бол {
        зарла а: тоо64 = т_эхлэл;
        зарла б: тоо64 = т_төгс;
        дараах();
        хэрэв т_төрөл == 8 бол {
            комп_дуудлага(а, б);
            гүн = гүн - 1;  // discard result
            дараах();  // ;
        } эсвэл {
            комп_оноолт(а, б);
        }
    }
    эсвэл {
        дараах();
    }
}

функц комп_блок() -> хоосон {
    дараах();  // consume {
    давтах т_төрөл != 11 бол {
        хэрэв т_төрөл == 0 бол { зогс; }
        комп_мэдэгдэл();
    }
    дараах();  // consume }
}

// ================= function compiler =================

функц комп_функц() -> хоосон {
    дараах();  // consume функц
    зарла а: тоо64 = т_эхлэл;
    зарла б: тоо64 = т_төгс;
    зарла идх: тоо64 = фн_ол(а, б);
    дараах();  // name
    ло_тоо = 0;
    гүн = 0;
    // parse params into the locals table (no emit yet)
    дараах();  // consume (
    зарла па: тоо64 = 0;
    давтах т_төрөл != 9 бол {
        зарла па_а: тоо64 = т_эхлэл;
        зарла па_б: тоо64 = т_төгс;
        дараах();  // param name
        дараах();  // param type
        хэрэв т_төрөл == 24 бол { дараах(); дараах(); }  // array type []
        лок_нэмэх(па_а, па_б);
        па = па + 1;
        хэрэв т_төрөл == 13 бол { дараах(); }  // comma
    }
    дараах();  // consume )
    дараах();  // consume ->
    дараах();  // consume return type
    хэрэв т_төрөл == 24 бол { дараах(); дараах(); }  // maybe [] on return type
    // forward prototype (no body): emit nothing
    хэрэв т_төрөл != 10 бол { буц; }
    // emit label, prologue, and move params into their slots
    гарга("_f");
    гарга_тоо(идх);
    гарга(":\n\tpushq %rbp\n\tmovq %rsp, %rbp\n\tsubq $2048, %rsp\n");
    зарла и: тоо64 = 0;
    давтах и < па бол {
        гарга("\tmovq ");
        хэрэв и == 0 бол { гарга("%rdi"); }
        эсвэл хэрэв и == 1 бол { гарга("%rsi"); }
        эсвэл хэрэв и == 2 бол { гарга("%rdx"); }
        эсвэл хэрэв и == 3 бол { гарга("%rcx"); }
        эсвэл хэрэв и == 4 бол { гарга("%r8"); }
        эсвэл { гарга("%r9"); }
        гарга(", ");
        гарга_тоо(0 - 8 - 8 * и);
        гарга("(%rbp)\n");
        и = и + 1;
    }
    комп_блок();
    гарга("\tmovq $0, %rax\n\tmovq %rbp, %rsp\n\tpopq %rbp\n\tret\n");
}
// ================= pre-pass: collect function & global names =================

функц урьдчилах() -> хоосон {
    зарла гүнз: тоо64 = 0;  // brace depth
    байр = 0;
    дараах();
    давтах т_төрөл != 0 бол {
        хэрэв т_төрөл == 10 бол { гүнз = гүнз + 1; дараах(); }
        эсвэл хэрэв т_төрөл == 11 бол { гүнз = гүнз - 1; дараах(); }
        эсвэл хэрэв гүнз == 0 бол {
            хэрэв кв("функц") == 1 бол {
                дараах();  // to name
                хэрэв фн_ол(т_эхлэл, т_төгс) < 0 бол {
                    фн_эхлэл[фн_тоо] = т_эхлэл;
                    фн_төгс[фн_тоо] = т_төгс;
                    фн_тоо = фн_тоо + 1;
                }
                дараах();  // past name
            }
            эсвэл хэрэв кв("зарла") == 1 бол {
                дараах();  // to name
                гл_эхлэл[гл_тоо] = т_эхлэл;
                гл_төгс[гл_тоо] = т_төгс;
                гл_массив[гл_тоо] = 0;
                гл_тоо = гл_тоо + 1;
                дараах();  // past name
            }
            эсвэл { дараах(); }
        }
        эсвэл { дараах(); }
    }
}
