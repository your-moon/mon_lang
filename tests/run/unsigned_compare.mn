// signed vs unsigned ordering must differ on high-bit values
// шалгах: гаралт "тэмдэгтэй:бага тэмдэггүй:их\n"
функц үндсэн() -> тоо {
    зарла т: тоо64 = 0 - 1;
    хэрэв т < 1 бол {
        мөр_хэвлэх("тэмдэгтэй:бага ");
    }
    зарла э: этоо64 = 0;
    э = э - 1;
    хэрэв э > 1 бол {
        мөр_хэвлэх("тэмдэггүй:их\n");
    }
    буц 0;
}
