// named module import: ашигла "..." гэж нэр; qualified access is
// validated against the module's export list
// шалгах: гаралт "77 1\n"
ашигла "../../selfhost/хүснэгт.mn" гэж хүс;

функц үндсэн() -> тоо {
    зарла х: Хүснэгт = хүс.шинэХүснэгт();
    х.тавих("түлхүүр", 77);
    хэвлэ(х.авах("түлхүүр"));
    мөр_хэвлэх(" ");
    хэвлэ(хүс.мөрТэнцүү("аб", "аб"));
    мөр_хэвлэх("\n");
    буц 0;
}
