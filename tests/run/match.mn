// Rust-style тааруул: patterns, wildcard, once-only scrutinee,
// break/continue inside arms bind to the enclosing loop
// шалгах: гаралт "нэг хоёр үсэг-ө бусад анхны-дуудлага 1 18\n"
функц нэрлэ(х тоо) -> хоосон {
    тааруул х {
        1 => { мөр_хэвлэх("нэг"); }
        2 => { мөр_хэвлэх("хоёр"); }
        'ө' => { мөр_хэвлэх("үсэг-ө"); }
        _ => { мөр_хэвлэх("бусад"); }
    }
    мөр_хэвлэх(" ");
    буц;
}

зарла тоолсон: тоо = 0;

функц дараагийн() -> тоо {
    тоолсон = тоолсон + 1;
    буц тоолсон;
}

функц үндсэн() -> тоо {
    нэрлэ(1);
    нэрлэ(2);
    нэрлэ(1257);
    нэрлэ(99);

    // scrutinee must evaluate exactly once
    тааруул дараагийн() {
        1 => { мөр_хэвлэх("анхны-дуудлага"); }
        _ => { мөр_хэвлэх("алдаа"); }
    }
    мөр_хэвлэх(" ");
    хэвлэ(тоолсон);

    // match inside a loop: break belongs to the loop
    зарла и: тоо = 0;
    зарла нийт: тоо = 0;
    давтах и < 10 бол {
        и = и + 1;
        тааруул и {
            3 => { үргэлжлүүл; }
            7 => { зогс; }
            _ => { нийт = нийт + и; }
        }
    }
    мөр_хэвлэх(" ");
    хэвлэ(нийт);
    мөр_хэвлэх("\n");
    буц 0;
}
