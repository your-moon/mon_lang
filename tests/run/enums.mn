// enum: variants are integer constants; match dispatches on them
// шалгах: гаралт "копи нэм буц бусад 0 1 3 их\n"
// шалгах: код 3
тоочих Үйлдэл { КОПИ, НЭМ, ХАС, БУЦ }
функц нэрлэ(у Үйлдэл) -> хоосон {
    тааруул у {
        Үйлдэл.КОПИ => { мөр_хэвлэх("копи"); }
        Үйлдэл.НЭМ  => { мөр_хэвлэх("нэм"); }
        Үйлдэл.БУЦ  => { мөр_хэвлэх("буц"); }
        _ => { мөр_хэвлэх("бусад"); }
    }
    мөр_хэвлэх(" ");
    буц;
}
функц үндсэн() -> тоо {
    нэрлэ(Үйлдэл.КОПИ); нэрлэ(Үйлдэл.НЭМ); нэрлэ(Үйлдэл.БУЦ); нэрлэ(Үйлдэл.ХАС);
    хэвлэ(Үйлдэл.КОПИ); мөр_хэвлэх(" "); хэвлэ(Үйлдэл.НЭМ); мөр_хэвлэх(" "); хэвлэ(Үйлдэл.БУЦ); мөр_хэвлэх(" ");
    зарла у: Үйлдэл = Үйлдэл.ХАС;
    хэрэв у > Үйлдэл.НЭМ бол { мөр_хэвлэх("их"); }
    мөр_хэвлэх("\n");
    буц Үйлдэл.БУЦ;
}
