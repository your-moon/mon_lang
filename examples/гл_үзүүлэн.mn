// гл_үзүүлэн — гл.mn сангаар өнгөт, гэрэлтүүлэгтэй эргэлдэх 3D шоо зурна.
// Терминалд 24-бит өнгөөр харуулж, эхний кадрыг /tmp/куб.ppm зураг болгон хадгална.
//   mon_lang gen examples/гл_үзүүлэн.mn --arch arm64 -o үзүүлэн && ./үзүүлэн
ашигла "гл.mn";
ашигла "систем"; // хүлээх

зарла кх: бутархай[]; зарла ку: бутархай[]; зарла кз: бутархай[]; // шоогийн орой

функц орой_тавь(и тоо64, х бутархай, у бутархай, з бутархай) -> хоосон {
    кх[и] = х; ку[и] = у; кз[и] = з;
}

// нүүрийн 4 орой → 2 гурвалжин, (р,г,б) өнгө, л гэрэлтүүлэг
функц нүүр(а тоо64, б тоо64, в тоо64, г тоо64, р тоо64, гн тоо64, бл тоо64, л бутархай) -> хоосон {
    гл_гурвалжин(а, б, в, р, гн, бл, л);
    гл_гурвалжин(а, в, г, р, гн, бл, л);
}

функц үндсэн() -> тоо {
    зарла ӨН: тоо64 = 64; зарла ҮН: тоо64 = 48;
    гл_эхлэх(ӨН, ҮН);
    кх = шинэ бутархай[8]; ку = шинэ бутархай[8]; кз = шинэ бутархай[8];
    орой_тавь(0, 0.0-1.0, 0.0-1.0, 0.0-1.0); орой_тавь(1, 1.0, 0.0-1.0, 0.0-1.0);
    орой_тавь(2, 1.0, 1.0, 0.0-1.0);         орой_тавь(3, 0.0-1.0, 1.0, 0.0-1.0);
    орой_тавь(4, 0.0-1.0, 0.0-1.0, 1.0);     орой_тавь(5, 1.0, 0.0-1.0, 1.0);
    орой_тавь(6, 1.0, 1.0, 1.0);             орой_тавь(7, 0.0-1.0, 1.0, 1.0);

    зарла Ө: бутархай = ӨН; зарла Ү: бутархай = ҮН;
    зарла а: бутархай = 0.6; зарла б: бутархай = 0.5;
    зарла кадр: тоо64 = 0;
    давтах кадр < 100000 бол {
        гл_цэвэрлэх(12, 12, 24); // бараан хөх арын дэвсгэр
        // орой бүрийг эргүүлж проекцлоно
        зарла са: бутархай = гл_синус(а); зарла ка: бутархай = гл_косинус(а);
        зарла сб: бутархай = гл_синус(б); зарла кб: бутархай = гл_косинус(б);
        зарла и: тоо64 = 0;
        давтах и < 8 бол {
            зарла х: бутархай = кх[и]; зарла у: бутархай = ку[и]; зарла з: бутархай = кз[и];
            зарла х1: бутархай = х * кб + з * сб;
            зарла з1: бутархай = (0.0 - х) * сб + з * кб;
            зарла у1: бутархай = у * ка - з1 * са;
            зарла з2: бутархай = у * са + з1 * ка;
            зарла зк: бутархай = з2 + 4.0;
            зарла м: бутархай = 30.0 / зк;
            гл_орой(и, Ө / 2.0 + х1 * м, Ү / 2.0 - у1 * м, 0.0 - зк);
            и = и + 1;
        }
        нүүр(4, 5, 6, 7, 230, 60, 60, 0.95);  // урд — улаан
        нүүр(1, 0, 3, 2, 60, 200, 90, 0.55);  // хойд — ногоон
        нүүр(0, 4, 7, 3, 70, 120, 240, 0.75); // зүүн — цэнхэр
        нүүр(5, 1, 2, 6, 240, 200, 60, 0.65); // баруун — шар
        нүүр(3, 7, 6, 2, 220, 120, 240, 1.0); // дээд — ягаан
        нүүр(0, 1, 5, 4, 80, 220, 220, 0.45); // доод — цайвар хөх
        хэрэв кадр == 0 бол { гл_зураг_хадгал("/tmp/куб.ppm"); }
        гл_үзүүл();
        а = а + 0.05; б = б + 0.03;
        хүлээх(40);
        кадр = кадр + 1;
    }
    буц 0;
}
