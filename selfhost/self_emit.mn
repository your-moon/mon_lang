// self_emit — жишээ: mon_lang дотроос гадаад хэрэгсэлгүйгээр төрөлх x86_64
// гүйцэтгэгдэх файл ялгаруулна. `макхо.mn`-ийн Mach-O бичигчийг ашиглаж
// exit(42) хийдэг жижиг программ бичээд /tmp/mon_self_emit_out-д хадгална.
ашигла "макхо.mn";
ашигла "тэмдэгт_мөр";

функц үндсэн() -> тоо {
    // x86_64: mov edi,42 ; mov eax,0x2000001 ; syscall  → exit(42)
    зарла код: мөр = мөр_шинэ(16);
    байт_тавих(код, 0, 191); байт_тавих(код, 1, 42); байт_тавих(код, 2, 0);
    байт_тавих(код, 3, 0);   байт_тавих(код, 4, 0);
    байт_тавих(код, 5, 184); байт_тавих(код, 6, 1); байт_тавих(код, 7, 0);
    байт_тавих(код, 8, 0);   байт_тавих(код, 9, 2);
    байт_тавих(код, 10, 15); байт_тавих(код, 11, 5);
    буц макхо_бич("/tmp/mon_self_emit_out", код, 12, 0);
}
