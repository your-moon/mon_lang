// Sandler Part II: бутархай (float64) — SSE arithmetic, comparisons,
// int<->double conversion, printed identically on both backends
// шалгах: гаралт "5.500000 7.000000 1.500000 1.750000 3.500000 их 3 -2.500000\n"
функц үндсэн() -> тоо {
    зарла а: бутархай = 3.5;
    зарла б: бутархай = 2.0;
    бутархайХэвлэх(а + б);
    мөр_хэвлэх(" ");
    бутархайХэвлэх(а * б);
    мөр_хэвлэх(" ");
    бутархайХэвлэх(а - б);
    мөр_хэвлэх(" ");
    бутархайХэвлэх(а / б);
    мөр_хэвлэх(" ");

    зарла т: тоо = 7;
    зарла в: бутархай = т;
    бутархайХэвлэх(в / б);
    мөр_хэвлэх(" ");

    хэрэв а > б бол { мөр_хэвлэх("их"); }
    мөр_хэвлэх(" ");
    зарла г: тоо = а;
    хэвлэ(г);
    мөр_хэвлэх(" ");

    бутархайХэвлэх(0.0 - 2.5);
    мөр_хэвлэх("\n");
    буц 0;
}
