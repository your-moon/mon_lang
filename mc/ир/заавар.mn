// заавар.mn — mc-ийн SSA завсрын дүрслэл (IR).
//
// Функц бол заавруудын жагсаалт. Утга бүр нэг л удаа оноо論дог темп (SSA):
// операнд нь темп эсвэл шууд тоо (immediate). Энэ дүрслэл дээр амьдрал
// (liveness) ба шугаман-скан регистр хуваарилалт хийгдэнэ.

// ---- үйлдлийн кодууд ----
зарла О_КОПИ: тоо = 0;     // %d = копи a
зарла О_НЭМ: тоо = 1;      // %d = a + b
зарла О_ХАС: тоо = 2;      // %d = a - b
зарла О_ҮРЖ: тоо = 3;      // %d = a * b
зарла О_ХУВ: тоо = 4;      // %d = a / b
зарла О_ҮЛД: тоо = 5;      // %d = a % b
зарла О_ТЭНЦ: тоо = 6;     // %d = (a == b)
зарла О_ҮГТЭНЦ: тоо = 7;   // %d = (a != b)
зарла О_БАГА: тоо = 8;     // %d = (a < b)
зарла О_ИХ: тоо = 9;       // %d = (a > b)
зарла О_ДУУД: тоо = 10;    // %d = дууд fn(...)
зарла О_БУЦ: тоо = 11;     // буц a   (терминатор)
зарла О_ҮСРЭ: тоо = 12;    // үсрэ L   (терминатор)
зарла О_САЛАА: тоо = 13;   // салаа c, L1, L2 (терминатор)
зарла О_ШОШГО: тоо = 14;   // L:  (блокийн эхлэл)

// ---- операндын төрөл ----
зарла ОП_ТЕМП: тоо = 0;    // темп id
зарла ОП_ИММ: тоо = 1;     // шууд тоо

// ---- нэг заавар ----
бүтэц Заавар {
    үйлдэл: тоо,   // дээрх О_* кодын нэг
    үр: тоо,       // үр дүнгийн темп id (терминаторт -1)
    а_төр: тоо,    // 1-р операндын төрөл (ОП_*)
    а: тоо,        // 1-р операндын утга
    б_төр: тоо,    // 2-р операндын төрөл
    б: тоо,        // 2-р операндын утга
    шошго: тоо,    // үсрэх/салаалах зорилтот блок
    шошго2: тоо,   // салаалалтын хоёр дахь зорилт
}

// ---- функцийн IR ----
бүтэц Функц {
    заавар: Заавар[],  // заавруудын жагсаалт
    зтоо: тоо,         // заавруудын тоо
    темп_тоо: тоо,     // дараагийн темп id
    шошго_тоо: тоо,    // дараагийн блок дугаар
}

хэрэгжүүл Функц {
    функц эхлүүл(өөрөө) -> хоосон {
        өөрөө.заавар = шинэ Заавар[8192];
        өөрөө.зтоо = 0;
        өөрөө.темп_тоо = 0;
        өөрөө.шошго_тоо = 0;
        буц;
    }

    // шинэ_темп — дараагийн SSA темп id-г буцаана.
    функц шинэ_темп(өөрөө) -> тоо {
        зарла т: тоо = өөрөө.темп_тоо;
        өөрөө.темп_тоо = өөрөө.темп_тоо + 1;
        буц т;
    }

    // шинэ_шошго — дараагийн блок дугаарыг буцаана.
    функц шинэ_шошго(өөрөө) -> тоо {
        зарла л: тоо = өөрөө.шошго_тоо;
        өөрөө.шошго_тоо = өөрөө.шошго_тоо + 1;
        буц л;
    }

    // нэмэх — бэлэн зааврыг жагсаалтад залгана.
    функц нэмэх(өөрөө, з Заавар) -> хоосон {
        өөрөө.заавар[өөрөө.зтоо] = з;
        өөрөө.зтоо = өөрөө.зтоо + 1;
        буц;
    }

    // имм — шууд тоог темп болгож ачаална, темпийг буцаана.
    функц имм(өөрөө, утга тоо) -> тоо {
        зарла д: тоо = өөрөө.шинэ_темп();
        зарла з: Заавар;
        з.үйлдэл = О_КОПИ;
        з.үр = д;
        з.а_төр = ОП_ИММ;
        з.а = утга;
        з.б_төр = ОП_ТЕМП;
        з.б = 0 - 1;
        өөрөө.нэмэх(з);
        буц д;
    }

    // хоёр — хоёр темп дээрх үйлдэл, үр дүнгийн темпийг буцаана.
    функц хоёр(өөрөө, үйлдэл тоо, а тоо, б тоо) -> тоо {
        зарла д: тоо = өөрөө.шинэ_темп();
        зарла з: Заавар;
        з.үйлдэл = үйлдэл;
        з.үр = д;
        з.а_төр = ОП_ТЕМП;
        з.а = а;
        з.б_төр = ОП_ТЕМП;
        з.б = б;
        өөрөө.нэмэх(з);
        буц д;
    }

    // буцаа — `буц a` терминатор нэмнэ.
    функц буцаа(өөрөө, а тоо) -> хоосон {
        зарла з: Заавар;
        з.үйлдэл = О_БУЦ;
        з.үр = 0 - 1;
        з.а_төр = ОП_ТЕМП;
        з.а = а;
        з.б_төр = ОП_ТЕМП;
        з.б = 0 - 1;   // ашиглагдаагүй операндыг темп бус болгоно
        өөрөө.нэмэх(з);
        буц;
    }

    // шошго_тавих — блокийн эхлэлийг тэмдэглэнэ.
    функц шошго_тавих(өөрөө, л тоо) -> хоосон {
        зарла з: Заавар;
        з.үйлдэл = О_ШОШГО;
        з.үр = 0 - 1;
        з.а_төр = ОП_ТЕМП;
        з.а = 0 - 1;
        з.б_төр = ОП_ТЕМП;
        з.б = 0 - 1;
        з.шошго = л;
        өөрөө.нэмэх(з);
        буц;
    }

    // салаа — `салаа c, L1, L2` терминатор нэмнэ.
    функц салаа(өөрөө, ц тоо, л1 тоо, л2 тоо) -> хоосон {
        зарла з: Заавар;
        з.үйлдэл = О_САЛАА;
        з.үр = 0 - 1;
        з.а_төр = ОП_ТЕМП;
        з.а = ц;
        з.б_төр = ОП_ТЕМП;
        з.б = 0 - 1;
        з.шошго = л1;
        з.шошго2 = л2;
        өөрөө.нэмэх(з);
        буц;
    }

    // үсрэ — `үсрэ L` терминатор нэмнэ.
    функц үсрэ(өөрөө, л тоо) -> хоосон {
        зарла з: Заавар;
        з.үйлдэл = О_ҮСРЭ;
        з.үр = 0 - 1;
        з.а_төр = ОП_ТЕМП;
        з.а = 0 - 1;
        з.б_төр = ОП_ТЕМП;
        з.б = 0 - 1;
        з.шошго = л;
        өөрөө.нэмэх(з);
        буц;
    }
}
