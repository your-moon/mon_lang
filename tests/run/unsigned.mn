// Sandler ch12: unsigned arithmetic, division, comparisons, zero-extension
// шалгах: гаралт "18446744073709551615 9223372036854775807 их 4294967295 5\n"
функц үндсэн() -> тоо {
    зарла а: этоо64 = 0;
    а = а - 1;
    эхэвлэ(а);
    мөр_хэвлэх(" ");

    зарла б: этоо64 = а / 2;
    эхэвлэ(б);
    мөр_хэвлэх(" ");

    хэрэв а > б бол {
        мөр_хэвлэх("их ");
    }

    зарла в: этоо = 0;
    в = в - 1;
    эхэвлэ(в);
    мөр_хэвлэх(" ");
    хэвлэ(а % 10);
    мөр_хэвлэх("\n");
    буц 0;
}
