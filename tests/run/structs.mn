// Sandler ch18 (adapted): Rust-style structs with methods, reference semantics
// шалгах: гаралт "43 10 90 100\n"
бүтэц Цэг {
    х: тоо,
    у: тоо64,
}

хэрэгжүүл Цэг {
    функц нийлбэр(өөрөө) -> тоо64 {
        буц өөрөө.х + өөрөө.у;
    }

    функц шилжүүл(өөрөө, дх тоо, ду тоо64) -> хоосон {
        өөрөө.х = өөрөө.х + дх;
        өөрөө.у = өөрөө.у + ду;
        буц;
    }
}

функц үндсэн() -> тоо {
    зарла ц: Цэг;
    ц.х = 3;
    ц.у = 40;
    хэвлэ(ц.нийлбэр());
    мөр_хэвлэх(" ");
    ц.шилжүүл(7, 50);
    хэвлэ(ц.х);
    мөр_хэвлэх(" ");
    хэвлэ(ц.у);
    мөр_хэвлэх(" ");
    хэвлэ(ц.нийлбэр());
    мөр_хэвлэх("\n");
    буц 0;
}
