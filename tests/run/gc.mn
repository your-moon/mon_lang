// allocation stress: ~51 MB of short-lived arrays trigger many
// collections; the long-lived array must survive intact (GC on --cc,
// bump-allocator on native — output is identical either way)
// шалгах: гаралт "4950\n"
функц үндсэн() -> тоо {
    зарла хадгалсан: тоо64[100];
    зарла и: тоо64 = 0;
    давтах и < 100 бол {
        хадгалсан[и] = и;
        и = и + 1;
    }
    зарла ж: тоо64 = 0;
    давтах ж < 200000 бол {
        зарла түр: тоо[64];
        түр[0] = ж;
        ж = ж + 1;
    }
    зарла нийт: тоо64 = 0;
    и = 0;
    давтах и < 100 бол {
        нийт = нийт + хадгалсан[и];
        и = и + 1;
    }
    хэвлэ(нийт);
    мөр_хэвлэх("\n");
    буц 0;
}
