// гл_куб — TinyGL маягийн софтвэр 3D рендерер (Bellard-ийн TinyGL-ээс санаа авав).
// Гадаад хэрэгсэлгүй: z-буфертэй гурвалжны растержуулалт, гэрэлтүүлэг, эргэлдэх
// шоо. Терминал руу ANSI-гаар зурна. arm64 дээр төрөлхөөр ажиллана:
//   mon_lang gen examples/гл_куб.mn --arch arm64 -o куб && ./куб
ашигла "тэмдэгт_мөр"; // мөр_шинэ, байт, байт_тавих, мөр_хэвлэх
ашигла "систем";      // хүлээх, дэлгэц_цэвэрлэх

зарла Ө: бутархай = 80.0;   // өргөн (weight/width chars)
зарла Ү: бутархай = 44.0;   // өндөр
зарла ӨН: тоо64 = 80;
зарла ҮН: тоо64 = 44;

// --------- математик ---------
функц синус(х бутархай) -> бутархай {
    давтах х > 3.14159265 бол { х = х - 6.28318530; }
    давтах х < 0.0 - 3.14159265 бол { х = х + 6.28318530; }
    зарла к: бутархай = х * х;
    буц х * (1.0 - к/6.0 * (1.0 - к/20.0 * (1.0 - к/42.0 * (1.0 - к/72.0))));
}
функц косинус(х бутархай) -> бутархай { буц синус(х + 1.57079632); }

// --------- төлөв (framebuffer + z-буфер) ---------
зарла дэлгэц: мөр;       // тэмдэгтийн буфер (ӨН*ҮН)
зарла збуф: бутархай[];  // гүний буфер
зарла ramp: мөр;         // гэрэлтүүлгийн тэмдэгтүүд

функц эхлүүл() -> хоосон {
    дэлгэц = мөр_шинэ(ӨН * ҮН + 16);
    збуф = шинэ бутархай[ӨН * ҮН];
    ramp = " .:-=+*#%@";
}

функц цэвэрлэх() -> хоосон {
    зарла и: тоо64 = 0;
    давтах и < ӨН * ҮН бол {
        байт_тавих(дэлгэц, и, 32); // зай
        збуф[и] = 0.0 - 1000000.0;
        и = и + 1;
    }
}

// гурвалжин зурна: проекцлосон 3 оройн индекс ба гэрэлтүүлэг л (0..1).
// (Координатыг пх/пу/пз массиваас уншина — 8-аас цөөн аргумент.)
функц гурвалжин(и0 тоо64, и1 тоо64, и2 тоо64, л бутархай) -> хоосон {
    зарла x0: бутархай = пх[и0]; зарла y0: бутархай = пу[и0]; зарла z0: бутархай = пз[и0];
    зарла x1: бутархай = пх[и1]; зарла y1: бутархай = пу[и1]; зарла z1: бутархай = пз[и1];
    зарла x2: бутархай = пх[и2]; зарла y2: бутархай = пу[и2]; зарла z2: бутархай = пз[и2];
    // хязгаарын хайрцаг
    зарла минx: тоо64 = хамгийнбага3(x0, x1, x2);
    зарла максx: тоо64 = хамгийних3(x0, x1, x2);
    зарла минy: тоо64 = хамгийнбага3(y0, y1, y2);
    зарла максy: тоо64 = хамгийних3(y0, y1, y2);
    хэрэв минx < 0 бол { минx = 0; }
    хэрэв минy < 0 бол { минy = 0; }
    хэрэв максx >= ӨН бол { максx = ӨН - 1; }
    хэрэв максy >= ҮН бол { максy = ҮН - 1; }

    зарла талбай: бутархай = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
    хэрэв талбай > 0.0 - 0.0001 бол { хэрэв талбай < 0.0001 бол { буц; } }

    // гэрэлтүүлгийг тэмдэгт болгох
    зарла илд: тоо64 = 0;
    хэрэв л > 0.0 бол { илд = л * 9.0; }
    хэрэв илд > 9 бол { илд = 9; }
    зарла тэмд: тоо64 = байт(ramp, илд);

    зарла py: тоо64 = минy;
    давтах py <= максy бол {
        зарла px: тоо64 = минx;
        давтах px <= максx бол {
            зарла fx: бутархай = px;
            зарла fy: бутархай = py;
            зарла w0: бутархай = (x1 - fx) * (y2 - fy) - (x2 - fx) * (y1 - fy);
            зарла w1: бутархай = (x2 - fx) * (y0 - fy) - (x0 - fx) * (y2 - fy);
            зарла w2: бутархай = (x0 - fx) * (y1 - fy) - (x1 - fx) * (y0 - fy);
            зарла дотор: тоо64 = 0;
            хэрэв талбай > 0.0 бол {
                хэрэв w0 >= 0.0 бол { хэрэв w1 >= 0.0 бол { хэрэв w2 >= 0.0 бол { дотор = 1; } } }
            } эсвэл {
                хэрэв w0 <= 0.0 бол { хэрэв w1 <= 0.0 бол { хэрэв w2 <= 0.0 бол { дотор = 1; } } }
            }
            хэрэв дотор == 1 бол {
                зарла б0: бутархай = w0 / талбай;
                зарла б1: бутархай = w1 / талбай;
                зарла б2: бутархай = w2 / талбай;
                зарла з: бутархай = б0 * z0 + б1 * z1 + б2 * z2;
                зарла индекс: тоо64 = py * ӨН + px;
                хэрэв з > збуф[индекс] бол {
                    збуф[индекс] = з;
                    байт_тавих(дэлгэц, индекс, тэмд);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

функц хамгийнбага3(а бутархай, б бутархай, в бутархай) -> тоо64 {
    зарла м: бутархай = а;
    хэрэв б < м бол { м = б; }
    хэрэв в < м бол { м = в; }
    буц м;
}
функц хамгийних3(а бутархай, б бутархай, в бутархай) -> тоо64 {
    зарла м: бутархай = а;
    хэрэв б > м бол { м = б; }
    хэрэв в > м бол { м = в; }
    буц м + 1;
}

// дэлгэцийг хэвлэх
функц үзүүл() -> хоосон {
    дэлгэц_цэвэрлэх();
    зарла py: тоо64 = 0;
    давтах py < ҮН бол {
        зарла px: тоо64 = 0;
        давтах px < ӨН бол {
            зарла мөр1: мөр = мөр_шинэ(2);
            байт_тавих(мөр1, 0, байт(дэлгэц, py * ӨН + px));
            мөр_хэвлэх(мөр1);
            px = px + 1;
        }
        мөр_хэвлэх("\n");
        py = py + 1;
    }
}

// --------- шоо ---------
// шоогийн 8 орой (гурав тус бүр эргүүлээд проекцлоод растержуулна)
зарла вкх: бутархай[]; зарла вку: бутархай[]; зарла вкз: бутархай[];

функц орой_тавих(и тоо64, х бутархай, у бутархай, з бутархай) -> хоосон {
    вкх[и] = х; вку[и] = у; вкз[и] = з;
}

// эргүүлсэн + проекцлосон дэлгэцийн координат (гурвалжинд өгөхөд бэлэн)
зарла пх: бутархай[]; зарла пу: бутархай[]; зарла пз: бутархай[];

функц хувиргах(а бутархай, б бутархай) -> хоосон {
    зарла са: бутархай = синус(а); зарла ка: бутархай = косинус(а);
    зарла сб: бутархай = синус(б); зарла кб: бутархай = косинус(б);
    зарла и: тоо64 = 0;
    давтах и < 8 бол {
        зарла х: бутархай = вкх[и]; зарла у: бутархай = вку[и]; зарла з: бутархай = вкз[и];
        // эргэлт Y тэнхлэгээр
        зарла х1: бутархай = х * кб + з * сб;
        зарла з1: бутархай = (0.0 - х) * сб + з * кб;
        // эргэлт X тэнхлэгээр
        зарла у1: бутархай = у * ка - з1 * са;
        зарла з2: бутархай = у * са + з1 * ка;
        // проекц (камер z=-4 дээр)
        зарла зк: бутархай = з2 + 4.0;
        зарла масштаб: бутархай = 40.0 / зк;
        пх[и] = Ө / 2.0 + х1 * масштаб;
        пу[и] = Ү / 2.0 - у1 * масштаб;
        пз[и] = 0.0 - зк; // ойр нь их (z-тест >)
        и = и + 1;
    }
}

// нүүр зурна (4 орой → 2 гурвалжин), гэрэлтүүлгийн утгаар
функц нүүр(а тоо64, б тоо64, в тоо64, г тоо64, л бутархай) -> хоосон {
    гурвалжин(а, б, в, л);
    гурвалжин(а, в, г, л);
}

функц үндсэн() -> тоо {
    эхлүүл();
    вкх = шинэ бутархай[8]; вку = шинэ бутархай[8]; вкз = шинэ бутархай[8];
    пх = шинэ бутархай[8]; пу = шинэ бутархай[8]; пз = шинэ бутархай[8];
    орой_тавих(0, 0.0-1.0, 0.0-1.0, 0.0-1.0); орой_тавих(1, 1.0, 0.0-1.0, 0.0-1.0);
    орой_тавих(2, 1.0, 1.0, 0.0-1.0);         орой_тавих(3, 0.0-1.0, 1.0, 0.0-1.0);
    орой_тавих(4, 0.0-1.0, 0.0-1.0, 1.0);     орой_тавих(5, 1.0, 0.0-1.0, 1.0);
    орой_тавих(6, 1.0, 1.0, 1.0);             орой_тавих(7, 0.0-1.0, 1.0, 1.0);

    зарла а: бутархай = 0.0;
    зарла б: бутархай = 0.0;
    зарла кадр: тоо64 = 0;
    давтах кадр < 1000 бол {
        цэвэрлэх();
        хувиргах(а, б);
        нүүр(4, 5, 6, 7, 0.9); // урд
        нүүр(1, 0, 3, 2, 0.5); // хойд
        нүүр(0, 4, 7, 3, 0.7); // зүүн
        нүүр(5, 1, 2, 6, 0.6); // баруун
        нүүр(3, 7, 6, 2, 1.0); // дээд
        нүүр(0, 1, 5, 4, 0.4); // доод
        үзүүл();
        а = а + 0.05; б = б + 0.03;
        хүлээх(30);
        кадр = кадр + 1;
    }
    буц 0;
}
