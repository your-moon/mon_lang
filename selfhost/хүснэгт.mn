// Хүснэгт: мөр түлхүүртэй, тоо64 утгатай hash map, бүхэлдээ mon_lang
// дээр бичигдсэн (FNV маягийн hash, шугаман хайлт).
// The self-hosted compiler's symbol tables will live on this.

бүтэц Хүснэгт {
    түлхүүр: мөр[],
    утга: тоо64[],
    төлөв: тоо[],
    багтаамж: тоо64,
    элементТоо: тоо64,
}

тунх функц мөрТэнцүү(а мөр, б мөр) -> тоо {
    зарла ау: тоо64 = мөрУрт(а);
    хэрэв ау != мөрУрт(б) бол { буц 0; }
    зарла и: тоо64 = 0;
    давтах и < ау бол {
        хэрэв байт(а, и) != байт(б, и) бол { буц 0; }
        и = и + 1;
    }
    буц 1;
}

тунх функц мөрХаш(с мөр) -> этоо64 {
    зарла х: этоо64 = 1099511628211;
    зарла у: тоо64 = мөрУрт(с);
    зарла и: тоо64 = 0;
    давтах и < у бол {
        х = (х + байт(с, и)) * 16777619;
        и = и + 1;
    }
    буц х;
}

хэрэгжүүл Хүснэгт {
    тунх функц эхлүүл(өөрөө, багтаамж тоо64) -> хоосон {
        өөрөө.багтаамж = багтаамж;
        өөрөө.элементТоо = 0;
        өөрөө.түлхүүр = шинэ мөр[багтаамж];
        өөрөө.утга = шинэ тоо64[багтаамж];
        өөрөө.төлөв = шинэ тоо[багтаамж];
        зарла и: тоо64 = 0;
        давтах и < багтаамж бол {
            өөрөө.төлөв[и] = 0;
            и = и + 1;
        }
        буц;
    }

    // slot of the key: its own cell, or the first empty one on its probe path
    тунх функц олох(өөрөө, к мөр) -> тоо64 {
        зарла суурь: этоо64 = 0;
        суурь = суурь + өөрөө.багтаамж;
        зарла и: тоо64 = 0;
        и = и + мөрХаш(к) % суурь;
        давтах 1 бол {
            хэрэв өөрөө.төлөв[и] == 0 бол { буц и; }
            хэрэв мөрТэнцүү(өөрөө.түлхүүр[и], к) == 1 бол { буц и; }
            и = и + 1;
            хэрэв и >= өөрөө.багтаамж бол { и = 0; }
        }
        буц 0 - 1;
    }

    тунх функц тавих(өөрөө, к мөр, в тоо64) -> хоосон {
        зарла и: тоо64 = өөрөө.олох(к);
        хэрэв өөрөө.төлөв[и] == 0 бол {
            өөрөө.төлөв[и] = 1;
            өөрөө.түлхүүр[и] = к;
            өөрөө.элементТоо = өөрөө.элементТоо + 1;
        }
        өөрөө.утга[и] = в;
        буц;
    }

    тунх функц байгааЮу(өөрөө, к мөр) -> тоо {
        буц өөрөө.төлөв[өөрөө.олох(к)];
    }

    тунх функц авах(өөрөө, к мөр) -> тоо64 {
        зарла и: тоо64 = өөрөө.олох(к);
        хэрэв өөрөө.төлөв[и] == 0 бол { буц 0; }
        буц өөрөө.утга[и];
    }
}

тунх функц шинэХүснэгт() -> Хүснэгт {
    зарла х: Хүснэгт;
    х.эхлүүл(64);
    буц х;
}
