// зангилаа.mn — mc-ийн хийсвэр синтакс мод (AST).
//
// Бүх зангилааг нэг `Зангилаа` бүтэц төлөөлнө: `төрөл` талбар ямар зангилаа
// болохыг заана; хүүхэд зангилаанууд а/б/в талбарт эсвэл `жагс` жагсаалтад
// байрлана. Хоосон хүүхэд бол нул бүтэц (0) — `== 0`-ээр шалгана.

// ---- зангилааны төрлүүд ----
зарла З_ПРОГ: тоо = 0;      // програм (жагс = дээд түвшний зарлалууд)
зарла З_ФУНКЦ: тоо = 1;     // функц (нэр, жагс = параметрүүд, б = их бие)
зарла З_БЛОК: тоо = 2;      // блок (жагс = мэдэгдлүүд)
зарла З_БУЦ: тоо = 3;       // буц (а = илэрхийлэл, нул байж болно)
зарла З_ХЭРЭВ: тоо = 4;     // хэрэв (а = нөхцөл, б = их бие, в = эсвэл)
зарла З_ДАВТАХ: тоо = 5;    // давтах (а = нөхцөл, б = их бие)
зарла З_ЗАРЛА: тоо = 6;     // орон нутгийн зарла (нэр, а = эхлэл утга)
зарла З_ОНОО: тоо = 7;      // оноолт (нэр, а = утга)
зарла З_ИЛЭРХ: тоо = 8;     // илэрхийллийн мэдэгдэл (а = илэрхийлэл)
зарла З_ТОО: тоо = 9;       // тооны литерал (утга)
зарла З_НЭР: тоо = 10;      // танигчийн лавлагаа (нэр)
зарла З_ХОЁР: тоо = 11;     // хоёрлосон үйлдэл (утга = оператор, а, б)
зарла З_ДУУДЛАГА: тоо = 12; // функц дуудлага (нэр, жагс = аргументууд)

// ---- Зангилаа бүтэц ----
бүтэц Зангилаа {
    төрөл: тоо,        // дээрх З_* төрлүүдийн нэг
    утга: тоо,         // литералын утга эсвэл операторын код
    нэр_э: тоо,        // нэр/танигчийн эх дэх байт мужийн эхлэл
    нэр_т: тоо,        // нэр/танигчийн байт мужийн төгсгөл
    а: Зангилаа,       // 1-р хүүхэд
    б: Зангилаа,       // 2-р хүүхэд
    в: Зангилаа,       // 3-р хүүхэд
    жагс: Зангилаа[],  // хүүхдүүдийн жагсаалт
    жтоо: тоо,         // жагсаалтын урт
}

// зг — шинэ зангилаа үүсгэнэ.
функц зг(төрөл тоо) -> Зангилаа {
    зарла з: Зангилаа;
    з.төрөл = төрөл;
    з.утга = 0;
    з.нэр_э = 0;
    з.нэр_т = 0;
    з.жтоо = 0;
    буц з;
}

// жагс_эхлүүл — зангилааны хүүхдийн жагсаалтыг бэлтгэнэ.
функц жагс_эхлүүл(з Зангилаа) -> хоосон {
    з.жагс = шинэ Зангилаа[256];
    з.жтоо = 0;
    буц;
}

// жагс_нэмэх — жагсаалтын төгсгөлд хүүхэд нэмнэ.
функц жагс_нэмэх(з Зангилаа, х Зангилаа) -> хоосон {
    з.жагс[з.жтоо] = х;
    з.жтоо = з.жтоо + 1;
    буц;
}
