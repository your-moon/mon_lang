// Sandler ch14: address-of, dereference, store-through, pointer args
// шалгах: гаралт "3 40 7 40 -9\n"
функц солих(а тоо*, б тоо*) -> хоосон {
    зарла түр: тоо = *а;
    *а = *б;
    *б = түр;
    буц;
}

функц тохируул(п тоо64*) -> хоосон {
    *п = 0 - 9;
    буц;
}

функц үндсэн() -> тоо {
    зарла х: тоо = 3;
    зарла у: тоо = 7;
    зарла п: тоо* = &х;
    хэвлэ(*п);
    мөр_хэвлэх(" ");
    *п = 40;
    хэвлэ(х);
    мөр_хэвлэх(" ");
    солих(&х, &у);
    хэвлэ(х);
    мөр_хэвлэх(" ");
    хэвлэ(у);
    мөр_хэвлэх(" ");
    зарла урт: тоо64 = 0;
    тохируул(&урт);
    хэвлэ(урт);
    мөр_хэвлэх("\n");
    буц 0;
}
