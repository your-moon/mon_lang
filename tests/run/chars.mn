// Sandler ch16 (adapted): тэмдэгт = Unicode codepoint, UTF-8 output
// шалгах: гаралт "өл!\n1072 25 дараалал-зөв\n"
функц үндсэн() -> тоо {
    зарла ү: тэмдэгт = 'ө';
    тэмдэгт_хэвлэх(ү);
    тэмдэгт_хэвлэх('л');
    тэмдэгт_хэвлэх('!');
    тэмдэгт_хэвлэх('\n');
    хэвлэ('а');
    мөр_хэвлэх(" ");
    хэвлэ('Z' - 'A');
    мөр_хэвлэх(" ");
    хэрэв 'б' > 'а' бол {
        мөр_хэвлэх("дараалал-зөв");
    }
    мөр_хэвлэх("\n");
    буц 0;
}
