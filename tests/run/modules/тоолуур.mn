бүтэц Тоолуур {
    утга: тоо64,
}

хэрэгжүүл Тоолуур {
    тунх функц нэм(өөрөө, д тоо64) -> хоосон {
        өөрөө.утга = өөрөө.утга + д;
        буц;
    }

    тунх функц авах(өөрөө) -> тоо64 {
        буц өөрөө.утга;
    }
}

тунх функц шинэТоолуур() -> Тоолуур {
    зарла т: Тоолуур;
    т.утга = 0;
    буц т;
}
