// mon_lang stage-0 lexer, written in mon_lang.
// Reads a source file and tokenizes it: the first component of the
// self-hosted compiler. Numbers, identifiers (UTF-8 Cyrillic included),
// strings, character literals, comments and operators.

бүтэц Лексер {
    эх: мөр,
    урт: тоо64,
    байрлал: тоо64,
    мөрДугаар: тоо,
}

хэрэгжүүл Лексер {
    тунх функц одоогийн(өөрөө) -> тоо {
        хэрэв өөрөө.байрлал >= өөрөө.урт бол {
            буц 0;
        }
        буц байт(өөрөө.эх, өөрөө.байрлал);
    }

    тунх функц урагшлах(өөрөө) -> хоосон {
        өөрөө.байрлал = өөрөө.байрлал + 1;
        буц;
    }

    // ASCII letter, underscore, or any UTF-8 continuation/lead byte
    тунх функц үсэгҮү(өөрөө, б тоо) -> тоо {
        хэрэв б >= 'a' бол { хэрэв б <= 'z' бол { буц 1; } }
        хэрэв б >= 'A' бол { хэрэв б <= 'Z' бол { буц 1; } }
        хэрэв б == '_' бол { буц 1; }
        хэрэв б >= 128 бол { буц 1; }
        буц 0;
    }

    тунх функц цифрҮү(өөрөө, б тоо) -> тоо {
        хэрэв б >= '0' бол { хэрэв б <= '9' бол { буц 1; } }
        буц 0;
    }
}

зарла тэмдэгтТоо: тоо = 0;
зарла тооТоо: тоо = 0;
зарла нэрТоо: тоо = 0;
зарла мөрТоо: тоо = 0;
зарла тайлбарТоо: тоо = 0;

функц үндсэн() -> тоо {
    хэрэв аргументТоо() < 2 бол {
        мөр_хэвлэх("хэрэглээ: lexer0 <файл.mn>\n");
        буц 2;
    }

    зарла л: Лексер;
    л.эх = файлУншихБүтэн(аргумент(1));
    л.урт = мөрУрт(л.эх);
    л.байрлал = 0;
    л.мөрДугаар = 1;

    давтах л.байрлал < л.урт бол {
        зарла б: тоо = л.одоогийн();

        хэрэв б == 10 бол {
            л.мөрДугаар = л.мөрДугаар + 1;
            л.урагшлах();
        } эсвэл хэрэв б == ' ' бол {
            л.урагшлах();
        } эсвэл хэрэв б == 9 бол {
            л.урагшлах();
        } эсвэл хэрэв б == 13 бол {
            л.урагшлах();
        } эсвэл хэрэв б == '/' бол {
            // comment to end of line, or a division operator
            л.урагшлах();
            хэрэв л.одоогийн() == '/' бол {
                давтах л.одоогийн() != 10 бол {
                    хэрэв л.байрлал >= л.урт бол { зогс; }
                    л.урагшлах();
                }
                тайлбарТоо = тайлбарТоо + 1;
            } эсвэл {
                тэмдэгтТоо = тэмдэгтТоо + 1;
            }
        } эсвэл хэрэв б == '"' бол {
            л.урагшлах();
            давтах л.одоогийн() != '"' бол {
                хэрэв л.байрлал >= л.урт бол { зогс; }
                хэрэв л.одоогийн() == 92 бол { л.урагшлах(); }
                л.урагшлах();
            }
            л.урагшлах();
            мөрТоо = мөрТоо + 1;
        } эсвэл хэрэв л.цифрҮү(б) == 1 бол {
            давтах л.цифрҮү(л.одоогийн()) == 1 бол {
                л.урагшлах();
            }
            тооТоо = тооТоо + 1;
        } эсвэл хэрэв л.үсэгҮү(б) == 1 бол {
            давтах л.байрлал < л.урт бол {
                зарла в: тоо = л.одоогийн();
                хэрэв л.үсэгҮү(в) == 0 бол {
                    хэрэв л.цифрҮү(в) == 0 бол { зогс; }
                }
                л.урагшлах();
            }
            нэрТоо = нэрТоо + 1;
        } эсвэл {
            тэмдэгтТоо = тэмдэгтТоо + 1;
            л.урагшлах();
        }
    }

    мөр_хэвлэх("мөр:");
    хэвлэ(л.мөрДугаар);
    мөр_хэвлэх(" нэр:");
    хэвлэ(нэрТоо);
    мөр_хэвлэх(" тоо:");
    хэвлэ(тооТоо);
    мөр_хэвлэх(" мөр-литерал:");
    хэвлэ(мөрТоо);
    мөр_хэвлэх(" тайлбар:");
    хэвлэ(тайлбарТоо);
    мөр_хэвлэх(" тэмдэгт:");
    хэвлэ(тэмдэгтТоо);
    мөр_хэвлэх("\n");
    буц 0;
}
