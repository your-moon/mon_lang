// систем: одоо (clock) and санамсаргүй_тоо (1..n) on every back end
// шалгах: гаралт "цаг ok 1 6\n"
ашигла "систем";
функц үндсэн() -> тоо {
    хэрэв одоо() > 1700000000 бол { мөр_хэвлэх("цаг ok "); }
    зарла бага: тоо = 1000;
    зарла их: тоо = 0;
    зарла и: тоо = 0;
    давтах и < 10000 бол {
        зарла р: тоо = санамсаргүй_тоо(6);
        хэрэв р < бага бол { бага = р; }
        хэрэв р > их бол { их = р; }
        и = и + 1;
    }
    хэвлэ(бага);
    мөр_хэвлэх(" ");
    хэвлэ(их);
    мөр_хэвлэх("\n");
    буц 0;
}
