// a compiler-shaped workload: scan a string byte by byte, build a new
// string with байт_тавих, count lines - what a mon_lang lexer will do.
// String literals are immutable (they live in read-only text); building
// strings needs a мөр_шинэ buffer.
// шалгах: гаралт "3 27 АБВ\n"
ашигла "тэмдэгт_мөр";
ашигла "файл";
функц үндсэн() -> тоо {
    файл_бичих("/tmp/mon_lex_test.txt", "нэг\nхоёр\nгурав\n");
    зарла с: мөр = файл_унших_бүтэн("/tmp/mon_lex_test.txt");
    зарла мөрТоо: тоо = 0;
    зарла и: тоо64 = 0;
    зарла у: тоо64 = мөр_урт(с);
    давтах и < у бол {
        хэрэв байт(с, и) == 10 бол {
            мөрТоо = мөрТоо + 1;
        }
        и = и + 1;
    }
    хэвлэ(мөрТоо);
    мөр_хэвлэх(" ");
    хэвлэ(у);
    мөр_хэвлэх(" ");

    зарла буф: мөр = мөр_шинэ(6);
    байт_тавих(буф, 0, 208);
    байт_тавих(буф, 1, 144);
    байт_тавих(буф, 2, 208);
    байт_тавих(буф, 3, 145);
    байт_тавих(буф, 4, 208);
    байт_тавих(буф, 5, 146);
    мөр_хэвлэх(буф);
    мөр_хэвлэх("\n");
    буц 0;
}
