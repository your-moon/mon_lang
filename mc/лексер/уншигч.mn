// уншигч.mn — эх сурвалжийг токен болгон уншина.
//
// Уншигч бол эх сурвалжийн буфер дээрх байрлалыг хадгалдаг бүтэц. `дараах`
// метод дараагийн токеныг буцаана; хоосон зайг алгасаж, `//` тайлбарыг таслана.

ашигла "тэмдэгт_мөр";

бүтэц Уншигч {
    эх: мөр,
    урт: тоо,
    байр: тоо,
}

хэрэгжүүл Уншигч {
    // эхлүүл — уншигчийг эх сурвалжаар тохируулна.
    функц эхлүүл(өөрөө, э мөр) -> хоосон {
        өөрөө.эх = э;
        өөрөө.урт = мөр_урт(э);
        өөрөө.байр = 0;
        буц;
    }

    // тэмд — и дэх байтыг буцаана (мужаас гарвал 0).
    функц тэмд(өөрөө, и тоо) -> тоо {
        хэрэв и >= өөрөө.урт бол { буц 0; }
        буц байт(өөрөө.эх, и);
    }

    // дараах — дараагийн токеныг уншиж буцаана.
    функц дараах(өөрөө) -> Токен {
        // хоосон зай ба // тайлбарыг алгасах
        давтах өөрөө.байр < өөрөө.урт бол {
            зарла в: тоо = өөрөө.тэмд(өөрөө.байр);
            хэрэв в == 32 бол { өөрөө.байр = өөрөө.байр + 1; }
            эсвэл хэрэв в == 10 бол { өөрөө.байр = өөрөө.байр + 1; }
            эсвэл хэрэв в == 9 бол { өөрөө.байр = өөрөө.байр + 1; }
            эсвэл хэрэв в == 13 бол { өөрөө.байр = өөрөө.байр + 1; }
            эсвэл хэрэв в == 47 бол {
                хэрэв өөрөө.тэмд(өөрөө.байр + 1) == 47 бол {
                    давтах өөрөө.байр < өөрөө.урт бол {
                        хэрэв өөрөө.тэмд(өөрөө.байр) == 10 бол { зогс; }
                        өөрөө.байр = өөрөө.байр + 1;
                    }
                } эсвэл { зогс; }
            }
            эсвэл { зогс; }
        }

        зарла т: Токен;
        т.эхлэл = өөрөө.байр;
        т.утга = 0;

        хэрэв өөрөө.байр >= өөрөө.урт бол {
            т.төрөл = Т_ТӨГС;
            т.төгс = өөрөө.байр;
            буц т;
        }

        зарла в: тоо = өөрөө.тэмд(өөрөө.байр);

        // тооны литерал
        хэрэв цифр_үү(в) == 1 бол {
            зарла н: тоо = 0;
            давтах цифр_үү(өөрөө.тэмд(өөрөө.байр)) == 1 бол {
                н = н * 10 + (өөрөө.тэмд(өөрөө.байр) - 48);
                өөрөө.байр = өөрөө.байр + 1;
            }
            т.төрөл = Т_ТОО;
            т.утга = н;
            т.төгс = өөрөө.байр;
            буц т;
        }

        // танигч
        хэрэв үсэг_үү(в) == 1 бол {
            давтах өөрөө.байр < өөрөө.урт бол {
                зарла к: тоо = өөрөө.тэмд(өөрөө.байр);
                хэрэв үсэг_үү(к) == 0 бол {
                    хэрэв цифр_үү(к) == 0 бол { зогс; }
                }
                өөрөө.байр = өөрөө.байр + 1;
            }
            т.төрөл = Т_НЭР;
            т.төгс = өөрөө.байр;
            буц т;
        }

        // мөрийн литерал "..."
        хэрэв в == 34 бол {
            өөрөө.байр = өөрөө.байр + 1;
            т.эхлэл = өөрөө.байр;
            давтах өөрөө.байр < өөрөө.урт бол {
                хэрэв өөрөө.тэмд(өөрөө.байр) == 34 бол { зогс; }
                өөрөө.байр = өөрөө.байр + 1;
            }
            т.төрөл = Т_МӨР;
            т.төгс = өөрөө.байр;
            өөрөө.байр = өөрөө.байр + 1;   // хаах хашилтыг алгасах
            буц т;
        }

        // нэг ба хос тэмдэгтийн операторууд
        өөрөө.байр = өөрөө.байр + 1;
        хэрэв в == 40 бол { т.төрөл = Т_НЭЭХ; }
        эсвэл хэрэв в == 41 бол { т.төрөл = Т_ХААХ; }
        эсвэл хэрэв в == 123 бол { т.төрөл = Т_ФИГНЭЭХ; }
        эсвэл хэрэв в == 125 бол { т.төрөл = Т_ФИГХААХ; }
        эсвэл хэрэв в == 44 бол { т.төрөл = Т_ТАСЛАЛ; }
        эсвэл хэрэв в == 59 бол { т.төрөл = Т_ЦЭГТ; }
        эсвэл хэрэв в == 58 бол { т.төрөл = Т_ХОЁРЦЭГ; }
        эсвэл хэрэв в == 43 бол { т.төрөл = Т_НЭМЭХ; }
        эсвэл хэрэв в == 42 бол { т.төрөл = Т_ҮРЖ; }
        эсвэл хэрэв в == 47 бол { т.төрөл = Т_ХУВААХ; }
        эсвэл хэрэв в == 45 бол {
            хэрэв өөрөө.тэмд(өөрөө.байр) == 62 бол {
                өөрөө.байр = өөрөө.байр + 1; т.төрөл = Т_СУМ;   // ->
            } эсвэл { т.төрөл = Т_ХАСАХ; }
        }
        эсвэл хэрэв в == 61 бол {
            хэрэв өөрөө.тэмд(өөрөө.байр) == 61 бол {
                өөрөө.байр = өөрөө.байр + 1; т.төрөл = Т_ТЭНЦ;
            } эсвэл { т.төрөл = Т_ОНОО; }
        }
        эсвэл хэрэв в == 60 бол {
            хэрэв өөрөө.тэмд(өөрөө.байр) == 61 бол {
                өөрөө.байр = өөрөө.байр + 1; т.төрөл = Т_БАГАТЭНЦ;
            } эсвэл { т.төрөл = Т_БАГА; }
        }
        эсвэл хэрэв в == 62 бол {
            хэрэв өөрөө.тэмд(өөрөө.байр) == 61 бол {
                өөрөө.байр = өөрөө.байр + 1; т.төрөл = Т_ИХТЭНЦ;
            } эсвэл { т.төрөл = Т_ИХ; }
        }
        эсвэл хэрэв в == 33 бол {
            хэрэв өөрөө.тэмд(өөрөө.байр) == 61 бол {
                өөрөө.байр = өөрөө.байр + 1; т.төрөл = Т_ҮГҮЙТЭНЦ;
            } эсвэл { т.төрөл = Т_ТӨГС; }
        }
        эсвэл { т.төрөл = Т_ТӨГС; }

        т.төгс = өөрөө.байр;
        буц т;
    }
}
