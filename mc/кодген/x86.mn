// x86.mn — хуваарилсан SSA IR-аас x86_64 ассемблер (AT&T) ялгаруулна.
//
// Регистр хуваарилалтын үр дүнг (Хуваарь) ашиглан темп бүрийг физик регистр
// эсвэл стекийн нүд рүү буулгаж, заавар тус бүрийг ялгаруулна. %rax-ийг
// завсрын скратч болгон ашиглана. Энэ бол стек-машин БУС — утга бүр өөрийн
// байрлалтай тул "дуудлагад устсан регистр" гэх алдаа гарахгүй.

ашигла "../ир";
ашигла "тэмдэгт_мөр";

// хуваарилалтын регистр индексийг физик регистрийн нэр рүү буулгана
// (бүгд callee-saved тул дуудлагын дундуур хадгалагдана).
функц рег_нэр(р тоо) -> мөр {
    хэрэв р == 0 бол { буц "%rbx"; }
    хэрэв р == 1 бол { буц "%r12"; }
    хэрэв р == 2 бол { буц "%r13"; }
    хэрэв р == 3 бол { буц "%r14"; }
    буц "%r15";
}

бүтэц Ялгаруулагч {
    гарц: мөр,   // ялгаруулсан ассемблерийн буфер
    поз: тоо,    // бичих байрлал
}

хэрэгжүүл Ялгаруулагч {
    функц эхлүүл(өөрөө) -> хоосон {
        өөрөө.гарц = мөр_шинэ(65536);
        өөрөө.поз = 0;
        буц;
    }

    функц гарга_т(өөрөө, б тоо) -> хоосон {
        байт_тавих(өөрөө.гарц, өөрөө.поз, б);
        өөрөө.поз = өөрөө.поз + 1;
        буц;
    }

    функц гарга(өөрөө, с мөр) -> хоосон {
        зарла у: тоо = мөр_урт(с);
        зарла и: тоо = 0;
        давтах и < у бол {
            өөрөө.гарга_т(байт(с, и));
            и = и + 1;
        }
        буц;
    }

    функц гарга_тоо(өөрөө, н тоо) -> хоосон {
        хэрэв н < 0 бол { өөрөө.гарга_т(45); н = 0 - н; }
        хэрэв н == 0 бол { өөрөө.гарга_т(48); буц; }
        зарла буф: тоо64[24];
        зарла к: тоо = 0;
        давтах н > 0 бол {
            буф[к] = 48 + (н % 10);
            н = н / 10;
            к = к + 1;
        }
        давтах к > 0 бол {
            к = к - 1;
            өөрөө.гарга_т(буф[к]);
        }
        буц;
    }

    // темпийн байрлалыг (регистр эсвэл стек нүд) ялгаруулна.
    функц байрлал(өөрөө, хув Хуваарь[], т тоо) -> хоосон {
        хэрэв хув[т].регистр >= 0 бол {
            өөрөө.гарга(рег_нэр(хув[т].регистр));
        } эсвэл {
            өөрөө.гарга_т(45);   // '-'
            өөрөө.гарга_тоо((хув[т].байр + 1) * 8);
            өөрөө.гарга("(%rbp)");
        }
    }

    // темпийг %rax-д ачаална.
    функц ачаал_рах(өөрөө, хув Хуваарь[], т тоо) -> хоосон {
        өөрөө.гарга("\tmovq ");
        өөрөө.байрлал(хув, т);
        өөрөө.гарга(", %rax\n");
    }

    // %rax-г темпийн байрлалд хадгална.
    функц хадгал_рах(өөрөө, хув Хуваарь[], т тоо) -> хоосон {
        өөрөө.гарга("\tmovq %rax, ");
        өөрөө.байрлал(хув, т);
        өөрөө.гарга("\n");
    }

    // хоёрлосон үйлдэл: %rax = a op b, дараа dst-д хадгална.
    функц хоёр_ял(өөрөө, хув Хуваарь[], з Заавар, үйлдэл мөр) -> хоосон {
        өөрөө.ачаал_рах(хув, з.а);
        өөрөө.гарга(үйлдэл);
        өөрөө.байрлал(хув, з.б);
        өөрөө.гарга(", %rax\n");
        өөрөө.хадгал_рах(хув, з.үр);
    }

    // ялгаруул — функцийн бүх зааврыг ялгаруулна.
    функц ялгаруул(өөрөө, ф Функц, хув Хуваарь[]) -> хоосон {
        зарла и: тоо = 0;
        давтах и < ф.зтоо бол {
            зарла з: Заавар;
            з = ф.заавар[и];
            тааруул з.үйлдэл {
                Үйлдэл.КОПИ => {
                    өөрөө.гарга("\tmovq $");
                    өөрөө.гарга_тоо(з.а);
                    өөрөө.гарга(", ");
                    өөрөө.байрлал(хув, з.үр);
                    өөрөө.гарга("\n");
                }
                Үйлдэл.НЭМ => { өөрөө.хоёр_ял(хув, з, "\taddq "); }
                Үйлдэл.ХАС => { өөрөө.хоёр_ял(хув, з, "\tsubq "); }
                Үйлдэл.ҮРЖ => { өөрөө.хоёр_ял(хув, з, "\timulq "); }
                Үйлдэл.БУЦ => {
                    өөрөө.ачаал_рах(хув, з.а);
                    өөрөө.гарга("\tret\n");
                }
                _ => { }
            }
            и = и + 1;
        }
        буц;
    }
}
