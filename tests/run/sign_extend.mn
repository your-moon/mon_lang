// regression: int32->int64 widening zero-extended (printed 4294967281)
// шалгах: гаралт "-15 -33 -9 -7\n"
функц урт(н тоо64) -> тоо64 {
    буц н;
}

функц өргөт() -> тоо64 {
    зарла жижиг: тоо = 0 - 7;
    буц жижиг;
}

функц үндсэн() -> тоо {
    хэвлэ(0 - 15);
    мөр_хэвлэх(" ");
    зарла д: тоо64 = 0 - 33;
    хэвлэ(д);
    мөр_хэвлэх(" ");
    хэвлэ(урт(0 - 9));
    мөр_хэвлэх(" ");
    хэвлэ(өргөт());
    мөр_хэвлэх("\n");
    буц 0;
}
