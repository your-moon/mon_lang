// ch19 regression pack: constant folding must preserve widths and the
// large-imm store path must not clobber the address register (R10)
// шалгах: гаралт "42 -9000000000 120 1\n"
зарла глоб: тоо = 0;

функц хажуу() -> тоо {
    глоб = глоб + 1;
    буц глоб;
}

функц үндсэн() -> тоо {
    зарла а: тоо = 2 * 3 * 7;
    хэвлэ(а);
    мөр_хэвлэх(" ");

    зарла урт: тоо64[2];
    урт[0] = 0 - 9000000000;
    хэвлэ(урт[0]);
    мөр_хэвлэх(" ");

    зарла ф: тоо64 = 1;
    зарла и: тоо = 1;
    давтах и <= 5 бол {
        ф = ф * и;
        и = и + 1;
    }
    хэвлэ(ф);
    мөр_хэвлэх(" ");

    хэрэв 1 + 1 == 2 бол {
        хажуу();
    }
    хэвлэ(глоб);
    мөр_хэвлэх("\n");
    буц 0;
}
