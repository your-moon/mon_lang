// regression: %r8/%r9 misnamed, stack params never loaded, rsp misaligned
// шалгах: гаралт "54321 36 709\n"
функц тав(а тоо64, б тоо64, в тоо64, г тоо64, д тоо64) -> тоо64 {
    буц а + б * 10 + в * 100 + г * 1000 + д * 10000;
}

функц найм(а тоо64, б тоо64, в тоо64, г тоо64, д тоо64, е тоо64, ж тоо64, з тоо64) -> тоо64 {
    буц а + б + в + г + д + е + ж + з;
}

функц долоо(а тоо64, б тоо64, в тоо64, г тоо64, д тоо64, е тоо64, ж тоо64) -> тоо64 {
    буц ж * 100 + а;
}

функц үндсэн() -> тоо {
    хэвлэ(тав(1, 2, 3, 4, 5));
    мөр_хэвлэх(" ");
    хэвлэ(найм(1, 2, 3, 4, 5, 6, 7, 8));
    мөр_хэвлэх(" ");
    хэвлэ(долоо(9, 2, 3, 4, 5, 6, 7));
    мөр_хэвлэх("\n");
    буц 0;
}
