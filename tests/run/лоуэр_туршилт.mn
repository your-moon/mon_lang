// mc: эх сурвалж → парсер → IR бууруулалт
// (2 + 3) * 4 → copi,copi,add,copi,mul,ret = 6 заавар; заавар[4]=Үйлдэл.ҮРЖ=3
// шалгах: гаралт "6 3\n"
ашигла "../../mc/ир";
ашигла "../../mc/парсер";

функц үндсэн() -> тоо {
    зарла п: Парсер;
    п.эхлүүл("функц т() -> тоо { буц (2 + 3) * 4; }");
    зарла пр: Зангилаа;
    пр = п.програм();
    зарла ф: Зангилаа;
    ф = пр.жагс[0];
    зарла бие: Зангилаа;
    бие = ф.б;
    зарла бу: Зангилаа;
    бу = бие.жагс[0];
    зарла илэрх: Зангилаа;
    илэрх = бу.а;

    зарла лф: Функц;
    лф.эхлүүл();
    зарла үр: тоо = лф.илэрхийлэл(илэрх);
    лф.буцаа(үр);

    хэвлэ(лф.зтоо); мөр_хэвлэх(" ");
    хэвлэ(лф.заавар[4].үйлдэл);
    мөр_хэвлэх("\n");
    буц 0;
}
