// амьдрал.mn — темп бүрийн амьдрах интервалыг тооцно (liveness).
//
// Шугаман-скан регистр хуваарилалтын оролт: темп t-ийн интервал бол [эхлэл,
// төгс] — эхлэл нь түүнийг тодорхойлсон заавар, төгс нь сүүлд ашигласан заавар.
// Утга нэг л удаа оноогддог (SSA) тул эхлэл нэг л байна. Дуудлагын хооронд
// амьд байгаа интервалыг хуваарилагч зөв зохицуулна — иймд "дуудлагад устсан
// регистр" гэх алдаа гарахгүй.

бүтэц Интервал {
    темп: тоо,    // темп id
    эхлэл: тоо,   // тодорхойлсон зааврын индекс
    төгс: тоо,    // сүүлд ашигласан зааврын индекс
}

хэрэгжүүл Функц {
    // операндыг темп болгож ашигласан бол интервалын төгсгөлийг шинэчлэнэ.
    функц ашиглалт(өөрөө, интервал Интервал[], төр тоо, утга тоо, и тоо) -> хоосон {
        хэрэв төр == ОП_ТЕМП бол {
            хэрэв утга >= 0 бол {
                интервал[утга].төгс = и;
            }
        }
        буц;
    }

    // амьдрал — темп бүрийн [эхлэл, төгс] интервалыг темп id-гээр индексжүүлж
    // буцаана (урт = темп_тоо).
    функц амьдрал(өөрөө) -> Интервал[] {
        зарла интервал: Интервал[];
        интервал = шинэ Интервал[өөрөө.темп_тоо];
        зарла т: тоо = 0;
        давтах т < өөрөө.темп_тоо бол {
            зарла ин: Интервал;
            ин.темп = т;
            ин.эхлэл = 0 - 1;
            ин.төгс = 0 - 1;
            интервал[т] = ин;
            т = т + 1;
        }

        зарла и: тоо = 0;
        давтах и < өөрөө.зтоо бол {
            зарла з: Заавар;
            з = өөрөө.заавар[и];
            // тодорхойлолт: эхлэлийг тэмдэглэ
            хэрэв з.үр >= 0 бол {
                интервал[з.үр].эхлэл = и;
                хэрэв интервал[з.үр].төгс < и бол {
                    интервал[з.үр].төгс = и;
                }
            }
            // ашиглалт: төгсгөлийг сунга
            өөрөө.ашиглалт(интервал, з.а_төр, з.а, и);
            өөрөө.ашиглалт(интервал, з.б_төр, з.б, и);
            и = и + 1;
        }
        буц интервал;
    }
}
