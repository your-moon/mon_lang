// гл — TinyGL маягийн софтвэр 3D рендер сан (Bellard-ийн TinyGL-ээс санаа авав).
//
// RGB framebuffer, z-буфер, өнгөт + гэрэлтүүлэгтэй гурвалжны растержуулалт.
// Гаралт: терминал руу ANSI 24-бит өнгө, эсвэл файл_бичих_байт-аар PPM зураг.
// Гадаад хэрэгсэлгүй, төрөлх кодоор ажиллана.
ашигла "тэмдэгт_мөр"; // мөр_шинэ, байт, байт_тавих, мөр_урт, мөр_хэвлэх
ашигла "систем";      // дэлгэц_цэвэрлэх
ашигла "файл";        // файл_бичих_байт

// --- төлөв ---
зарла _фб: мөр;        // RGB framebuffer (ӨН*ҮН*3 байт)
зарла _зб: бутархай[]; // гүний буфер
зарла _ӨН: тоо64;      // өргөн (пиксел)
зарла _ҮН: тоо64;      // өндөр
зарла _өх: бутархай[]; зарла _өу: бутархай[]; зарла _өз: бутархай[]; // проекцлосон орой

// --- математик ---
функц гл_синус(х бутархай) -> бутархай {
    давтах х > 3.14159265 бол { х = х - 6.28318530; }
    давтах х < 0.0 - 3.14159265 бол { х = х + 6.28318530; }
    зарла к: бутархай = х * х;
    буц х * (1.0 - к/6.0 * (1.0 - к/20.0 * (1.0 - к/42.0 * (1.0 - к/72.0))));
}
функц гл_косинус(х бутархай) -> бутархай { буц гл_синус(х + 1.57079632); }

// гл_эхлэх — рендерийг ө×ү пикселийн хэмжээгээр эхлүүлнэ (орой хүртэл 64).
функц гл_эхлэх(ө тоо64, ү тоо64) -> хоосон {
    _ӨН = ө; _ҮН = ү;
    _фб = мөр_шинэ(ө * ү * 3 + 16);
    _зб = шинэ бутархай[ө * ү];
    _өх = шинэ бутархай[64]; _өу = шинэ бутархай[64]; _өз = шинэ бутархай[64];
}

// гл_цэвэрлэх — framebuffer-ийг (р,г,б) арын өнгөөр, z-буферийг хол болгоно.
функц гл_цэвэрлэх(р тоо64, г тоо64, б тоо64) -> хоосон {
    зарла и: тоо64 = 0; зарла н: тоо64 = _ӨН * _ҮН;
    давтах и < н бол {
        байт_тавих(_фб, и * 3, р); байт_тавих(_фб, и * 3 + 1, г); байт_тавих(_фб, и * 3 + 2, б);
        _зб[и] = 0.0 - 1000000.0;
        и = и + 1;
    }
}

// гл_орой — проекцлосон дэлгэцийн оройг (индекс, x, y, гүн z) тэмдэглэнэ.
функц гл_орой(и тоо64, х бутархай, у бутархай, з бутархай) -> хоосон {
    _өх[и] = х; _өу[и] = у; _өз[и] = з;
}

функц _бага3(а бутархай, б бутархай, в бутархай) -> тоо64 {
    зарла м: бутархай = а; хэрэв б < м бол { м = б; } хэрэв в < м бол { м = в; } буц м;
}
функц _их3(а бутархай, б бутархай, в бутархай) -> тоо64 {
    зарла м: бутархай = а; хэрэв б > м бол { м = б; } хэрэв в > м бол { м = в; } буц м + 1;
}

// гл_гурвалжин — 3 оройн индекс, суурь өнгө (р,г,б), гэрэлтүүлэг л (0..1).
// z-буфер, барицентрик дүүргэлт, өнгө×гэрэлтүүлэг.
функц гл_гурвалжин(и0 тоо64, и1 тоо64, и2 тоо64, р тоо64, г тоо64, б тоо64, л бутархай) -> хоосон {
    зарла x0: бутархай = _өх[и0]; зарла y0: бутархай = _өу[и0]; зарла z0: бутархай = _өз[и0];
    зарла x1: бутархай = _өх[и1]; зарла y1: бутархай = _өу[и1]; зарла z1: бутархай = _өз[и1];
    зарла x2: бутархай = _өх[и2]; зарла y2: бутархай = _өу[и2]; зарла z2: бутархай = _өз[и2];
    зарла талбай: бутархай = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
    хэрэв талбай > 0.0 - 0.01 бол { хэрэв талбай < 0.01 бол { буц; } }

    зарла ир: тоо64 = р; зарла иг: тоо64 = г; зарла иб: тоо64 = б;
    хэрэв л < 1.0 бол { ир = р; иг = г; иб = б; ир = р * л; иг = г * л; иб = б * л; }

    зарла минx: тоо64 = _бага3(x0, x1, x2); зарла максx: тоо64 = _их3(x0, x1, x2);
    зарла минy: тоо64 = _бага3(y0, y1, y2); зарла максy: тоо64 = _их3(y0, y1, y2);
    хэрэв минx < 0 бол { минx = 0; } хэрэв минy < 0 бол { минy = 0; }
    хэрэв максx >= _ӨН бол { максx = _ӨН - 1; } хэрэв максy >= _ҮН бол { максy = _ҮН - 1; }

    зарла py: тоо64 = минy;
    давтах py <= максy бол {
        зарла px: тоо64 = минx;
        давтах px <= максx бол {
            зарла fx: бутархай = px; зарла fy: бутархай = py;
            зарла w0: бутархай = (x1 - fx) * (y2 - fy) - (x2 - fx) * (y1 - fy);
            зарла w1: бутархай = (x2 - fx) * (y0 - fy) - (x0 - fx) * (y2 - fy);
            зарла w2: бутархай = (x0 - fx) * (y1 - fy) - (x1 - fx) * (y0 - fy);
            зарла дотор: тоо64 = 0;
            хэрэв талбай > 0.0 бол {
                хэрэв w0 >= 0.0 бол { хэрэв w1 >= 0.0 бол { хэрэв w2 >= 0.0 бол { дотор = 1; } } }
            } эсвэл {
                хэрэв w0 <= 0.0 бол { хэрэв w1 <= 0.0 бол { хэрэв w2 <= 0.0 бол { дотор = 1; } } }
            }
            хэрэв дотор == 1 бол {
                зарла з: бутархай = (w0 * z0 + w1 * z1 + w2 * z2) / талбай;
                зарла инд: тоо64 = py * _ӨН + px;
                хэрэв з > _зб[инд] бол {
                    _зб[инд] = з;
                    байт_тавих(_фб, инд * 3, ир); байт_тавих(_фб, инд * 3 + 1, иг); байт_тавих(_фб, инд * 3 + 2, иб);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

// гл_үзүүл — framebuffer-ийг терминал руу ANSI 24-бит өнгөөр зурна.
// Бүх кадрыг нэг буферт угсарч нэг л удаа хэвлэнэ (ESC=27 байтыг шууд бичнэ —
// mon_lang-ийн мөр литерал \x1b хэлбэрийн escape дэмждэггүй).
функц гл_үзүүл() -> хоосон {
    дэлгэц_цэвэрлэх();
    зарла буф: мөр = мөр_шинэ(_ӨН * _ҮН * 24 + _ҮН * 8 + 16);
    зарла п: тоо64 = 0;
    зарла py: тоо64 = 0;
    давтах py < _ҮН бол {
        зарла px: тоо64 = 0;
        давтах px < _ӨН бол {
            зарла и: тоо64 = (py * _ӨН + px) * 3;
            байт_тавих(буф, п, 27); п = п + 1;         // ESC
            п = _мөр_нэмэх(буф, п, "[48;2;");
            п = _тоо_нэмэх(буф, п, байт(_фб, и));     байт_тавих(буф, п, 59); п = п + 1; // ;
            п = _тоо_нэмэх(буф, п, байт(_фб, и + 1)); байт_тавих(буф, п, 59); п = п + 1; // ;
            п = _тоо_нэмэх(буф, п, байт(_фб, и + 2));
            байт_тавих(буф, п, 109); п = п + 1;        // m
            байт_тавих(буф, п, 32);  п = п + 1;        // зай
            px = px + 1;
        }
        байт_тавих(буф, п, 27); п = п + 1;
        п = _мөр_нэмэх(буф, п, "[0m");
        байт_тавих(буф, п, 10); п = п + 1;             // \n
        py = py + 1;
    }
    байт_тавих(буф, п, 0); // NUL
    мөр_хэвлэх(буф);
}

// гл_зураг_хадгал — framebuffer-ийг P6 PPM зураг болгон файлд бичнэ.
функц гл_зураг_хадгал(зам мөр) -> хоосон {
    // толгой "P6\n{ӨН} {ҮН}\n255\n"-г буфер урд нэмнэ гэвч энгийнээр:
    // толгойг тусад нь бичих боломжгүй тул нэг буферт хийе.
    зарла нийт: тоо64 = _ӨН * _ҮН * 3;
    зарла толгой: мөр = мөр_шинэ(64);
    зарла п: тоо64 = 0;
    п = _мөр_нэмэх(толгой, п, "P6\n");
    п = _тоо_нэмэх(толгой, п, _ӨН); п = _мөр_нэмэх(толгой, п, " ");
    п = _тоо_нэмэх(толгой, п, _ҮН); п = _мөр_нэмэх(толгой, п, "\n255\n");
    зарла бүх: мөр = мөр_шинэ(п + нийт + 16);
    зарла и: тоо64 = 0;
    давтах и < п бол { байт_тавих(бүх, и, байт(толгой, и)); и = и + 1; }
    зарла ж: тоо64 = 0;
    давтах ж < нийт бол { байт_тавих(бүх, п + ж, байт(_фб, ж)); ж = ж + 1; }
    файл_бичих_байт(зам, бүх, п + нийт);
}

функц _мөр_нэмэх(б мөр, п тоо64, с мөр) -> тоо64 {
    зарла и: тоо64 = 0; зарла у: тоо64 = мөр_урт(с);
    давтах и < у бол { байт_тавих(б, п, байт(с, и)); п = п + 1; и = и + 1; }
    буц п;
}
функц _тоо_нэмэх(б мөр, п тоо64, н тоо64) -> тоо64 {
    хэрэв н == 0 бол { байт_тавих(б, п, 48); буц п + 1; }
    зарла бр: тоо64[24]; зарла к: тоо64 = 0;
    давтах н > 0 бол { бр[к] = 48 + (н % 10); н = н / 10; к = к + 1; }
    давтах к > 0 бол { к = к - 1; байт_тавих(б, п, бр[к]); п = п + 1; }
    буц п;
}
